{%- comment -%}
  The stretch test: a real trunk photo you can grab and pull. The fabric warps under the cursor (or finger) and
  springs back when let go, with a live stretch meter and the fabric facts beside it. Until someone grabs it, it
  gives itself a little tug now and then.
{%- endcomment -%}
<section class="st" id="{{ section.settings.anchor | default: 'stretch' }}" data-stretch
  data-l0="{{ section.settings.state_rest | escape }}" data-l1="{{ section.settings.state_gentle | escape }}"
  data-l2="{{ section.settings.state_more | escape }}" data-l3="{{ section.settings.state_max | escape }}"
  data-back="{{ section.settings.state_back | escape }}">
  <div class="wrap st-grid">
    <div class="st-copy">
      <span class="eyebrow"><i></i>{{ section.settings.eyebrow | escape }}</span>
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.lead != blank -%}<p class="st-lead">{{ section.settings.lead | escape }}</p>{%- endif -%}
      <div class="st-meter">
        <div class="st-meter-top"><span>{{ section.settings.meter_label | escape }}</span><b data-st-pct>100%</b></div>
        <div class="st-bar"><span data-st-fill></span></div>
        <p class="st-state" data-st-state aria-live="polite">{{ section.settings.state_rest | escape }}</p>
      </div>
      {%- if section.blocks.size > 0 -%}
        <ul class="st-facts">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}><b>{{ block.settings.value | escape }}</b><span>{{ block.settings.label | escape }}</span></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn-lime" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span class="arrow">→</span></a>
      {%- endif -%}
    </div>
    <div class="st-stage">
      <canvas class="st-canvas" data-st-canvas data-cursor="{{ section.settings.cursor_label | escape }}" role="img" aria-label="{{ section.settings.canvas_label | escape }}"></canvas>
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: class: 'st-src', alt: section.settings.image.alt, loading: 'lazy', widths: '600, 900, 1200' }}
      {%- else -%}
        <img class="st-src" src="{{ 'trunk-yellow-close.jpg' | asset_url }}" alt="" width="576" height="720" loading="lazy">
      {%- endif -%}
      <span class="st-hint" aria-hidden="true"><i></i>{{ section.settings.hint | escape }}</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Stretch test",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "stretch" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The stretch test" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pull it. It snaps back." },
    { "type": "textarea", "id": "lead", "label": "Text", "default": "Grab the waistband or a leg and give it a proper tug. This is the fabric you will be living in." },
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "A close, front-on shot of the trunks. Empty uses the Sunshine trunk photo." },
    { "type": "text", "id": "hint", "label": "Hint", "default": "Grab and pull" },
    { "type": "text", "id": "cursor_label", "label": "Cursor label", "default": "Pull" },
    { "type": "text", "id": "canvas_label", "label": "Photo description (screen readers)", "default": "Jumper trunks you can stretch by dragging." },
    { "type": "text", "id": "meter_label", "label": "Meter label", "default": "Stretch" },
    { "type": "text", "id": "state_rest", "label": "At rest", "default": "Go on, give it a tug." },
    { "type": "text", "id": "state_gentle", "label": "A little pull", "default": "Gentle. It can take more." },
    { "type": "text", "id": "state_more", "label": "A good pull", "default": "Now we're talking." },
    { "type": "text", "id": "state_max", "label": "Full pull", "default": "Full stretch. Still comfy." },
    { "type": "text", "id": "state_back", "label": "Let go", "default": "Boing. Back in shape." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the stretch" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "4-way" },
        { "type": "text", "id": "label", "label": "Label", "default": "Stretch, every direction" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stretch test",
      "blocks": [
        { "type": "fact", "settings": { "value": "4-way", "label": "Stretch, every direction" } },
        { "type": "fact", "settings": { "value": "95%", "label": "Cotton, the soft kind" } },
        { "type": "fact", "settings": { "value": "5%", "label": "Elastane for the snap-back" } }
      ]
    }
  ]
}
{% endschema %}
