        "q1": {
          "type": "question",
          "settings": {
            "question": "Which size should I get?",
            "answer": "<p>Go by your waist on the size chart above. Between two sizes? Size up for room, down for a snug hold.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "How do packs work?",
            "answer": "<p>Pick 3 or 5, mix any colours in one size, and they ship together in the Jumper box.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "What are they made of?",
            "answer": "<p>95% combed cotton and 5% elastane, with a woven waistband that is brushed soft on the inside.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Can I exchange them?",
            "answer": "<p>Unworn, sealed packs can be swapped within 15 days. Write in with your order number.</p>"
          }
        },
