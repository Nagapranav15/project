{%- assign title = 'customer.activate' | t -%}
{% render 'page-hero', eyebrow: 'Account', title: title, badge: true %}
<section class="authwrap">
  <div class="wrap">
    <div class="panel">
      <p>{{ 'customer.activate_text' | t }}</p>
      {%- form 'activate_customer_password', class: 'fx' -%}
        {%- if form.errors -%}<div class="err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label>{{ 'customer.password' | t }}<input type="password" name="customer[password]" autocomplete="new-password" required></label>
        <label>{{ 'customer.password_confirm' | t }}<input type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
        <div class="actions">
          <button class="btn btn-ink" type="submit">{{ 'customer.activate' | t }} <span class="arrow">→</span></button>
          <button class="btn btn-ghost" type="submit" name="decline">{{ 'customer.decline' | t }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>
