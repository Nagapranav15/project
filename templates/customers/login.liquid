<section class="auth">
  <div class="wrap auth-grid">
    {%- assign brand_heading = 'customer.login_title' | t -%}
    {% render 'auth-brand', heading: brand_heading %}
    <div class="auth-card" id="login">
      <nav class="auth-tabs" aria-label="{{ 'customer.account_aria' | t: name: '' | strip }}">
        <a href="{{ routes.account_login_url }}" aria-current="page">{{ 'customer.login' | t }}</a>
        <a href="{{ routes.account_register_url }}">{{ 'customer.create' | t }}</a>
      </nav>
      {%- form 'customer_login', class: 'fx' -%}
        {%- if form.errors -%}<div class="err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label>{{ 'customer.email' | t }}<input type="email" name="customer[email]" autocomplete="email" autocapitalize="off" required></label>
        {%- if form.password_needed -%}
          <label>{{ 'customer.password' | t }}<input type="password" name="customer[password]" autocomplete="current-password" required></label>
        {%- endif -%}
        <div class="actions">
          <button class="btn btn-ink" type="submit">{{ 'customer.login' | t }} <span class="arrow">→</span></button>
          {%- if form.password_needed -%}<a href="#recover">{{ 'customer.forgot' | t }}</a>{%- endif -%}
        </div>
      {%- endform -%}
      {%- if shop.checkout.guest_login -%}
        {%- form 'guest_login', class: 'fx' -%}<button class="btn btn-ghost" type="submit">{{ 'customer.guest' | t }}</button>{%- endform -%}
      {%- endif -%}
      <div class="auth-recover" id="recover">
        <h2>{{ 'customer.recover_title' | t }}</h2>
        <p>{{ 'customer.recover_text' | t }}</p>
        {%- form 'recover_customer_password', class: 'fx' -%}
          {%- if form.posted_successfully? -%}<p class="ok" role="status">{{ 'customer.recover_sent' | t }}</p>{%- endif -%}
          {%- if form.errors -%}<div class="err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <label>{{ 'customer.email' | t }}<input type="email" name="email" autocomplete="email" autocapitalize="off" required></label>
          <div class="actions"><button class="btn btn-ghost" type="submit">{{ 'customer.recover_submit' | t }} <span class="arrow">→</span></button></div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>
