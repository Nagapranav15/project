<section class="auth scheme-lime">
  <div class="auth__card window">
    <div class="window__bar"><span class="window__dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="t-label">join_the_crew.exe</span></div>
    <div class="window__body">
      <h1 class="t-headline">{{ 'customer.create' | t }}</h1>
      {%- form 'create_customer', class: 'form' -%}
        {%- if form.errors -%}<div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field"><label class="t-label" for="RegFirst">{{ 'customer.first_name' | t }}</label><input id="RegFirst" name="customer[first_name]" autocomplete="given-name"></div>
        <div class="field"><label class="t-label" for="RegLast">{{ 'customer.last_name' | t }}</label><input id="RegLast" name="customer[last_name]" autocomplete="family-name"></div>
        <div class="field"><label class="t-label" for="RegEmail">{{ 'customer.email' | t }}</label><input id="RegEmail" type="email" name="customer[email]" autocomplete="email" required></div>
        <div class="field"><label class="t-label" for="RegPass">{{ 'customer.password' | t }}</label><input id="RegPass" type="password" name="customer[password]" autocomplete="new-password" required></div>
        <button class="btn btn--block" type="submit">{{ 'customer.create' | t }} {% render 'icon', icon: 'arrow' %}</button>
      {%- endform -%}
      <div class="auth__links"><a href="{{ routes.account_login_url }}">{{ 'customer.login' | t }}</a></div>
    </div>
  </div>
</section>
