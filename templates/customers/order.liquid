{%- assign title = 'customer.order_title' | t: name: order.name -%}
{%- assign placed = order.created_at | date: '%d %b %Y' -%}
{%- capture meta -%}<span>{{ 'customer.placed' | t: date: placed }}</span>{%- if order.cancelled -%}{%- assign cd = order.cancelled_at | date: '%d %b %Y' -%}<span>{{ 'customer.cancelled' | t: date: cd }}</span>{%- endif -%}{%- endcapture -%}
{%- capture crumbs -%}<a href="{{ routes.account_url }}">{{ 'customer.back' | t }}</a>{%- endcapture -%}
{% render 'page-hero', eyebrow: 'Account', title: title, meta: meta, crumbs: crumbs, badge: true %}
<section class="acct">
  <div class="wrap">
    <div style="overflow-x:auto">
      <table class="otable">
        <thead><tr><th>{{ 'customer.product' | t }}</th><th>{{ 'customer.price' | t }}</th><th>{{ 'customer.quantity' | t }}</th><th class="r">{{ 'customer.total' | t }}</th></tr></thead>
        <tbody>
          {%- for li in order.line_items -%}
            <tr>
              <td>
                <div style="display:flex;gap:12px;align-items:flex-start">
                  {%- if li.image -%}{{ li.image | image_url: width: 120 | image_tag: alt: '', loading: 'lazy' }}{%- endif -%}
                  <div><a href="{{ li.url }}">{{ li.title | escape }}</a>
                    {%- for p in li.properties -%}{%- assign first = p.first | slice: 0 -%}{%- if p.last != blank and first != '_' -%}<br><small>{{ p.first | escape }}: {{ p.last | escape }}</small>{%- endif -%}{%- endfor -%}
                    {%- if li.sku != blank -%}<br><small>{{ 'customer.sku' | t }} {{ li.sku }}</small>{%- endif -%}
                    {%- if li.fulfillment -%}<br><small>{%- assign fd = li.fulfillment.created_at | date: '%d %b %Y' -%}{{ 'customer.fulfilled' | t: date: fd }}{%- if li.fulfillment.tracking_url -%} · <a href="{{ li.fulfillment.tracking_url }}">{{ 'customer.track' | t }}</a>{%- endif -%}</small>{%- endif -%}
                  </div>
                </div>
              </td>
              <td>{{ li.final_price | money_without_trailing_zeros }}</td>
              <td>{{ li.quantity }}</td>
              <td class="r">{{ li.final_line_price | money_without_trailing_zeros }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
        <tfoot>
          <tr><td colspan="3">{{ 'customer.subtotal' | t }}</td><td class="r">{{ order.line_items_subtotal_price | money_without_trailing_zeros }}</td></tr>
          {%- for d in order.cart_level_discount_applications -%}<tr><td colspan="3">{{ 'customer.discount' | t }} ({{ d.title | escape }})</td><td class="r">−{{ d.total_allocated_amount | money_without_trailing_zeros }}</td></tr>{%- endfor -%}
          {%- for sm in order.shipping_methods -%}<tr><td colspan="3">{{ 'customer.shipping' | t }} ({{ sm.title | escape }})</td><td class="r">{{ sm.price | money_without_trailing_zeros }}</td></tr>{%- endfor -%}
          {%- for tl in order.tax_lines -%}<tr><td colspan="3">{{ 'customer.tax' | t }} ({{ tl.title | escape }} {{ tl.rate | times: 100 }}%)</td><td class="r">{{ tl.price | money_without_trailing_zeros }}</td></tr>{%- endfor -%}
          <tr><td colspan="3">{{ 'customer.total' | t }}</td><td class="r">{{ order.total_price | money_with_currency }}</td></tr>
        </tfoot>
      </table>
    </div>
    <div style="display:grid;gap:26px">
      <div class="panel"><h2 style="font-size:22px">{{ 'customer.billing' | t }}</h2><span class="status">{{ order.financial_status_label }}</span><p>{{ order.billing_address | format_address }}</p></div>
      {%- if order.shipping_address -%}<div class="panel" style="--spark:var(--cyan)"><h2 style="font-size:22px">{{ 'customer.shipping_address' | t }}</h2><span class="status">{{ order.fulfillment_status_label }}</span><p>{{ order.shipping_address | format_address }}</p></div>{%- endif -%}
    </div>
  </div>
</section>
