{%- if customer.first_name != blank -%}{%- assign title = 'customer.hey' | t: name: customer.first_name -%}{%- else -%}{%- assign title = 'customer.hey_anon' | t -%}{%- endif -%}
{%- capture meta -%}<a href="{{ routes.account_logout_url }}" style="text-decoration:none">{{ 'customer.logout' | t }}</a>{%- endcapture -%}
{% render 'page-hero', eyebrow: 'Account', title: title, meta: meta, badge: true %}
<section class="acct">
  <div class="wrap">
    <div>
      <h2 style="font-size:clamp(28px,3vw,40px);margin-bottom:20px">{{ 'customer.orders' | t }}</h2>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <div style="overflow-x:auto">
            <table class="otable">
              <thead><tr><th>{{ 'customer.order' | t }}</th><th>{{ 'customer.date' | t }}</th><th>{{ 'customer.payment' | t }}</th><th>{{ 'customer.fulfillment' | t }}</th><th class="r">{{ 'customer.total' | t }}</th></tr></thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr><td><a href="{{ order.customer_url }}">{{ order.name }}</a></td><td>{{ order.created_at | date: '%d %b %Y' }}</td><td><span class="status">{{ order.financial_status_label }}</span></td><td>{{ order.fulfillment_status_label }}</td><td class="r">{{ order.total_price | money_without_trailing_zeros }}</td></tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
          {% render 'pager', paginate: paginate %}
        {%- else -%}
          <div class="empty-state"><b>{{ 'customer.no_orders' | t }}</b><a class="btn btn-ink" href="{{ routes.all_products_collection_url }}">{{ 'cart.shop' | t }} <span class="arrow">→</span></a></div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
    <div class="panel" style="--spark:var(--cyan)">
      <h2>{{ 'customer.default_address' | t }}</h2>
      {%- if customer.default_address -%}<p>{{ customer.default_address | format_address }}</p>{%- endif -%}
      <div><a class="btn btn-ink" href="{{ routes.account_addresses_url }}" style="--spark:var(--cyan)">{{ 'customer.view_addresses' | t: count: customer.addresses_count }} <span class="arrow">→</span></a></div>
    </div>
  </div>
</section>
