{%- assign title = 'customer.addresses' | t -%}
{%- capture crumbs -%}<a href="{{ routes.account_url }}">{{ 'customer.back' | t }}</a>{%- endcapture -%}
{% render 'page-hero', eyebrow: 'Account', title: title, crumbs: crumbs, badge: true %}
<section class="acct">
  <div class="wrap">
    <div style="display:grid;gap:20px;align-content:start">
      {%- paginate customer.addresses by 10 -%}
        {%- for address in customer.addresses -%}
          <div class="addr">
            {%- if address == customer.default_address -%}<span class="tag">{{ 'customer.default' | t }}</span>{%- endif -%}
            <p>{{ address | format_address }}</p>
            <div class="addr-actions">
              <button class="tbtn" type="button" data-toggle="edit-{{ address.id }}" aria-controls="edit-{{ address.id }}">{{ 'customer.edit' | t }}</button>
              {%- form 'customer_address', address, class: 'inline-del' -%}
                <input type="hidden" name="_method" value="delete">
                <button class="tbtn" type="submit" data-confirm="{{ 'customer.delete_confirm' | t | escape }}">{{ 'customer.delete' | t }}</button>
              {%- endform -%}
            </div>
            <div id="edit-{{ address.id }}" hidden>
              {%- form 'customer_address', address, class: 'fx' -%}
                {% render 'address-fields', form: form, address: address, key: address.id %}
                <div class="actions"><button class="btn btn-ink" type="submit">{{ 'customer.update' | t }} <span class="arrow">→</span></button></div>
              {%- endform -%}
            </div>
          </div>
        {%- endfor -%}
        {% render 'pager', paginate: paginate %}
      {%- endpaginate -%}
    </div>
    <div class="panel" style="--spark:var(--cyan)">
      <h2>{{ 'customer.add_address' | t }}</h2>
      {%- form 'customer_address', customer.new_address, class: 'fx' -%}
        {%- if form.errors -%}<div class="err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        {% render 'address-fields', form: form, address: customer.new_address, key: 'new' %}
        <div class="actions"><button class="btn btn-ink" type="submit" style="--spark:var(--cyan)">{{ 'customer.add_address' | t }} <span class="arrow">→</span></button></div>
      {%- endform -%}
    </div>
  </div>
</section>
<script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer="defer"></script>
<script>
  // Shopify's country and state picker: fills states for the chosen country and hides the field when there are none
  document.addEventListener('DOMContentLoaded', function () {
    if (!window.Shopify || !Shopify.CountryProvinceSelector) return;
    document.querySelectorAll('[data-address-country]').forEach(function (s) {
      var k = s.dataset.addressCountry;
      new Shopify.CountryProvinceSelector('AddressCountry_' + k, 'AddressProvince_' + k, { hideElement: 'AddressProvinceContainer_' + k });
    });
  });
</script>
