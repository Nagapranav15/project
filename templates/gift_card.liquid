{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'gift_card.title' | t }} &ndash; {{ shop.name }}</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&display=swap">
    {%- style -%}
      @font-face { font-family: "Obv"; src: url({{ 'obv-500.otf' | asset_url }}) format("opentype"); font-weight: 500; font-display: swap; }
      @font-face { font-family: "Obv"; src: url({{ 'obv-600.otf' | asset_url }}) format("opentype"); font-weight: 600; font-display: swap; }
      :root { --lime: {{ settings.color_lime }}; --ink: {{ settings.color_ink }}; --paper: {{ settings.color_paper }}; --pink: {{ settings.color_pink }}; }
    {%- endstyle -%}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body>
    <main class="gc">
      <div class="card-gc">
        {% render 'wordmark', label: shop.name %}
        <span class="eyebrow" style="color:var(--lime)">{{ 'gift_card.title' | t }}</span>
        <h1>{{ gift_card.initial_value | money_without_trailing_zeros }}</h1>
        {%- if gift_card.balance != gift_card.initial_value -%}<p>{{ gift_card.balance | money }} left</p>{%- endif -%}
        {%- if gift_card.expired -%}<span class="status">{{ 'gift_card.expired' | t }}</span>{%- endif -%}
        {%- if gift_card.enabled == false -%}<span class="status">{{ 'gift_card.disabled' | t }}</span>{%- endif -%}
        {%- if gift_card.expires_on -%}{%- assign exp = gift_card.expires_on | date: '%d %b %Y' -%}<p>{{ 'gift_card.expires' | t: date: exp }}</p>{%- endif -%}
        <div class="code">{{ gift_card.code | format_code }}</div>
        <div id="QrCode" class="qr" data-identifier="{{ gift_card.qr_identifier }}"></div>
        <div style="display:flex;flex-wrap:wrap;gap:12px">
          <button class="btn btn-lime" type="button" data-copy="{{ gift_card.code }}" data-done="{{ 'gift_card.copied' | t }}">{{ 'gift_card.copy' | t }}</button>
          <a class="btn btn-ghost" href="{{ shop.url }}" target="_blank" rel="noopener">{{ 'gift_card.shop' | t }} <span class="arrow">→</span></a>
          <button class="btn btn-ghost" type="button" onclick="window.print()">{{ 'gift_card.print' | t }}</button>
        </div>
        {%- if gift_card.pass_url -%}<a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_card.wallet' | t }}" loading="lazy"></a>{%- endif -%}
      </div>
    </main>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        var q = document.getElementById('QrCode');
        if (window.QRCode && q) new QRCode(q, { text: q.dataset.identifier, width: 120, height: 120 });
        document.querySelectorAll('[data-copy]').forEach(function (b) { b.addEventListener('click', function () { navigator.clipboard && navigator.clipboard.writeText(b.dataset.copy).then(function () { b.textContent = b.dataset.done; }); }); });
      });
    </script>
  </body>
</html>
