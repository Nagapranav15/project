<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_lime }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      {%- comment -%} Brand icon with J, Ink on Lime (Brand Guidelines v1.5, icon colourways) {%- endcomment -%}
      <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32.png' | asset_url }}">
      <link rel="icon" type="image/png" sizes="512x512" href="{{ 'favicon-512.png' | asset_url }}">
      <link rel="apple-touch-icon" href="{{ 'favicon-180.png' | asset_url }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {{ 'obv-500.otf' | asset_url | preload_tag: as: 'font', type: 'font/otf', crossorigin: 'anonymous' }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&display=swap">

    {%- style -%}
      @font-face { font-family: "Obv"; src: url({{ 'obv-400.otf' | asset_url }}) format("opentype"); font-weight: 400; font-display: swap; }
      @font-face { font-family: "Obv"; src: url({{ 'obv-500.otf' | asset_url }}) format("opentype"); font-weight: 500; font-display: swap; }
      @font-face { font-family: "Obv"; src: url({{ 'obv-600.otf' | asset_url }}) format("opentype"); font-weight: 600; font-display: swap; }
    {%- endstyle -%}

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {%- style -%}
      :root {
        --lime: {{ settings.color_lime }};
        --ink: {{ settings.color_ink }};
        --paper: {{ settings.color_paper }};
        --yellow: {{ settings.color_yellow }};
        --cyan: {{ settings.color_cyan }};
        --orange: {{ settings.color_orange }};
        --pink: {{ settings.color_pink }};
        --purple: {{ settings.color_purple }};
        {%- if settings.brand_font_family != blank %}
        --font: {{ settings.brand_font_family }}, "Obv", "Archivo", system-ui, sans-serif;
        {%- endif %}
      }
    {%- endstyle -%}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.Jumper = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          search: {{ routes.search_url | json }},
          predictive: {{ routes.predictive_search_url | json }}
        },
        moneyFormat: {{ shop.money_format | json }},
        template: {{ template.name | json }},
        motion: {{ settings.enable_motion | json }},
        boxSrc: {% if settings.cart_show_box %}{{ 'cart-box.js' | asset_url | json }}{% else %}""{% endif %},
        loader: {% if settings.show_loader and request.design_mode == false %}{{ settings.loader_style | json }}{% else %}"none"{% endif %},
        strings: {
          added: {{ 'cart.added' | t: title: '[[title]]' | json }},
          pickSize: {{ 'products.pick_size' | t | json }},
          adding: {{ 'products.adding' | t | json }},
          addedShort: {{ 'products.added_short' | t | json }},
          quickAdd: {{ 'products.quick_add' | t | json }},
          soldOut: {{ 'products.sold_out' | t | json }},
          unavailable: {{ 'products.unavailable' | t | json }},
          addToCart: {{ 'products.add_to_cart' | t | json }},
          error: {{ 'cart.error' | t | json }},
          boxFull: {{ 'pack.box_full' | t | json }},
          addMore: {{ 'pack.add_more_html' | t: count: '[[count]]' | json }},
          packAdded: {{ 'pack.added' | t: count: '[[count]]' | json }},
          pieceAdded: {{ 'pack.piece_added' | t | json }},
          packConnect: {{ 'pack.connect' | t: name: '[[name]]' | json }},
          packSizeOut: {{ 'pack.size_out' | t: name: '[[name]]' | json }},
          joinBadEmail: {{ 'newsletter.bad_email' | t | json }},
          joinWelcome: {{ 'newsletter.welcome_name' | t: name: '[[name]]' | json }},
          joinWelcomeAnon: {{ 'newsletter.welcome' | t | json }},
          demoCard: {{ 'products.demo' | t | json }},
          motionOff: {{ 'motion.off' | t | json }},
          motionOn: {{ 'motion.on' | t | json }},
          motionAsk: {{ 'motion.ask' | t | json }},
          motionTurnOff: {{ 'motion.turn_off' | t | json }},
          searchAll: {{ 'search.view_all' | t | json }},
          onePiece: {{ 'pack.one_piece' | t | json }},
          nPack: {{ 'pack.n_pack' | t: count: '[[count]]' | json }},
          packSize: {{ 'cart.pack_size' | t: size: '[[size]]' | json }}
        }
      };
    </script>
    <script src="{{ 'gsap.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'ScrollTrigger.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'lenis.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.suffix | handle }}{% endif %}">
    {%- if settings.show_loader and request.design_mode == false -%}
      {%- if settings.loader_style == 'badge' -%}
        {% render 'loader-badge' %}
      {%- else -%}
        {% render 'loader' %}
      {%- endif -%}
    {%- endif -%}
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <div class="scrim" id="scrim"></div>
    {% section 'cart-drawer' %}
    {% render 'packing' %}
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    {%- if settings.show_draft_badge -%}
      <div class="draft">{{ settings.draft_badge_text }}</div>
    {%- endif -%}
  </body>
</html>
