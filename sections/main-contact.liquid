<section class="page-hero scheme-lime">
  <div class="container">
    <p class="t-label section-head__label"><span class="num">✦</span> {{ 'contact.label' | t }}</p>
    <h1 class="t-display page-hero__title">{{ page.title }}</h1>
    {% render 'character', name: 'thumbs', class: 'page-hero__char' %}
  </div>
</section>
<section class="section scheme-paper">
  <div class="container cart-page__grid">
    <div class="prose rte t-body">{{ page.content }}</div>
    {%- form 'contact', class: 'form' -%}
      {%- if form.posted_successfully? -%}<p class="form-success" role="status">{{ 'contact.success' | t }}</p>{%- endif -%}
      {%- if form.errors -%}<div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label class="t-label" for="ContactName">{{ 'contact.name' | t }}</label><input id="ContactName" name="contact[name]" autocomplete="name" value="{{ form.name }}"></div>
      <div class="field"><label class="t-label" for="ContactEmail">{{ 'contact.email' | t }}</label><input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></div>
      <div class="field"><label class="t-label" for="ContactBody">{{ 'contact.message' | t }}</label><textarea id="ContactBody" name="contact[body]">{{ form.body }}</textarea></div>
      <button class="btn" type="submit">{{ 'contact.send' | t }} {% render 'icon', icon: 'arrow' %}</button>
    {%- endform -%}
  </div>
</section>
{% schema %}{ "name": "Contact form" }{% endschema %}
