{%- assign tabs = 'pink,cyan,orange,yellow' | split: ',' -%}
<section class="section scheme-paper" style="border-top: 2px solid var(--ink)">
  <div class="container">
    <header class="section-head">
      <div>
        <p class="t-label section-head__label"><span class="num">+</span> {{ section.settings.label }}</p>
        <h2 class="t-headline">{{ section.settings.heading }}</h2>
      </div>
    </header>
    <div class="grid grid--cards" data-recos data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4">
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        {%- for rec in recommendations.products -%}
          {%- assign t = forloop.index0 | modulo: tabs.size -%}
          {% render 'product-card', product: rec, tab: tabs[t], index: forloop.index0 %}
        {%- endfor -%}
      {%- elsif recommendations.performed == false -%}
        {%- comment -%} Filled by JS via the Section Rendering API {%- endcomment -%}
      {%- else -%}
        {% render 'demo-grid', limit: 4, tabs: tabs %}
      {%- endif -%}
    </div>
  </div>
</section>
<script>
  (() => {
    const el = document.currentScript.previousElementSibling.querySelector('[data-recos]');
    if (!el || el.children.length) return;
    fetch(el.dataset.url).then((r) => r.text()).then((html) => {
      const doc = new DOMParser().parseFromString(html, 'text/html');
      const fresh = doc.querySelector('[data-recos]');
      if (fresh && fresh.children.length) { el.innerHTML = fresh.innerHTML; el.querySelectorAll('.reveal').forEach((n) => n.classList.add('is-in')); }
    });
  })();
</script>

{% schema %}
{
  "name": "Pairs well with",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Complete the drawer" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pairs well with." }
  ]
}
{% endschema %}
