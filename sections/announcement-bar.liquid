{%- if section.blocks.size > 0 -%}
<div class="announce" role="region" aria-label="{{ 'accessibility.announcement' | t }}">
  <div class="ticker" style="--speed: {{ section.settings.speed }}s">
    {%- for pass in (1..2) -%}
      <div class="ticker__track"{% if pass == 2 %} aria-hidden="true"{% endif %}>
        {%- for i in (1..3) -%}
          {%- for block in section.blocks -%}
            <span class="ticker__item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
            </span>
            {% render 'sparkle', class: 'ticker__spark' %}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement ticker",
  "settings": [
    { "type": "range", "id": "speed", "label": "Loop duration (seconds)", "min": 10, "max": 80, "step": 2, "default": 36 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping all India" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Announcement ticker", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
