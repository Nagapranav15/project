{%- liquid
  assign line = ''
  for block in section.blocks
    assign msg = block.settings.text | escape
    assign line = line | append: msg | append: ' &nbsp;✦&nbsp; '
  endfor
-%}
{%- if section.blocks.size > 0 -%}
  <div class="announce" aria-label="{{ 'accessibility.offers' | t }}" {{ section.shopify_attributes }}>
    {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}" style="text-decoration:none">{%- endif -%}
    <span class="track" data-speed="{{ section.settings.speed }}">{{ line }}{{ line }}</span>
    {%- if section.settings.link != blank -%}</a>{%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announce",
  "max_blocks": 8,
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "Speed",
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "default": 0.6
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "FREE SHIPPING OVER RS. 999"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ],
  "enabled_on": {
    "groups": [
      "header"
    ]
  }
}
{% endschema %}
