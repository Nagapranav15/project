<section class="lifestyle-section">
  <div class="container">
    <div class="lifestyle-split-grid">
      <!-- Left: High Energy Fashion Media -->
      <div class="lifestyle-media-frame">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: class: 'lifestyle-video-bg', loading: 'lazy' }}
        {%- else -%}
          <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=1200&q=80" alt="Cyberpunk Fashion Campaign" class="lifestyle-video-bg">
        {%- endif -%}
        <div class="lifestyle-badge-floating">
          <span class="badge-neon badge-purple">{{ section.settings.badge | default: 'CAMPAIGN 2026' }}</span>
        </div>
      </div>

      <!-- Right: Handwritten Typography & Parallax Glow -->
      <div class="lifestyle-text-content">
        <span class="badge-neon" style="width:max-content;">{{ section.settings.tagline | default: 'UNFILTERED FREEDOM' }}</span>
        <div class="lifestyle-quote-handwritten">
          "{{ section.settings.quote | default: 'We didn\'t just redesign underwear. We eliminated friction from modern living.' }}"
        </div>
        <p class="lifestyle-desc">
          {{ section.settings.text | default: 'Born at the intersection of Japanese cyber aesthetics and hyper-ergonomic fabric engineering. Jumper delivers uncompromised support for creators, athletes, and night owls who refuse to conform.' }}
        </p>
        <div>
          <a href="{{ section.settings.btn_link | default: '#shop' }}" class="btn btn-secondary">
            <span>{{ section.settings.btn_text | default: 'View The Lookbook' }}</span>
            <i data-lucide="external-link" style="width:16px;height:16px;"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lifestyle Story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lifestyle Media Image"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Media Badge",
      "default": "CAMPAIGN 2026"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "UNFILTERED FREEDOM"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote Headline",
      "default": "We didn't just redesign underwear. We eliminated friction from modern living."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Story Body Text",
      "default": "Born at the intersection of Japanese cyber aesthetics and hyper-ergonomic fabric engineering. Jumper delivers uncompromised support for creators, athletes, and night owls who refuse to conform."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "View The Lookbook"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Lifestyle Story"
    }
  ]
}
{% endschema %}
