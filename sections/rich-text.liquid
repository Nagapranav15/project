<section class="rich {{ section.settings.ground }}">
  <div class="wrap">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte"><p>{{ section.settings.text | escape }}</p></div>{%- endif -%}
    {%- if section.settings.button != blank -%}<a class="btn btn-ink" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button | escape }} <span class="arrow">→</span></a>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Big statement",
  "settings": [
    { "type": "select", "id": "ground", "label": "Ground", "options": [{ "value": "", "label": "Paper" }, { "value": "lime", "label": "Lime" }, { "value": "ink", "label": "Ink" }], "default": "lime" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Jumper" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wear it loud." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Soft stretch trunks for the gym, the office and the rooftop." },
    { "type": "text", "id": "button", "label": "Button label", "default": "Shop new in" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "presets": [{ "name": "Big statement" }]
}
{% endschema %}
