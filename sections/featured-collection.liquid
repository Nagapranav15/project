{%- liquid
  assign tabs = section.settings.tabs | remove: ' ' | split: ','
  assign coll = collections[section.settings.collection]
-%}
<section class="section scheme-{{ section.settings.scheme }} featured" id="shop">
  <div class="container">
    <header class="section-head">
      <div>
        <p class="t-label section-head__label reveal"><span class="num">{{ section.settings.number }}</span> {{ section.settings.label }}</p>
        <h2 class="t-headline reveal" style="--d: 1">{{ section.settings.heading }}</h2>
      </div>
      <div class="section-head__side reveal" style="--d: 2">
        <p class="t-body">{{ section.settings.text }}</p>
        <a class="link-arrow" href="{% if coll != blank %}{{ coll.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">{{ section.settings.link_label }}</a>
      </div>
    </header>

    <div class="grid grid--cards">
      {%- if coll != blank and coll.products_count > 0 -%}
        {%- for product in coll.products limit: section.settings.limit -%}
          {%- assign t = forloop.index0 | modulo: tabs.size -%}
          {% render 'product-card', product: product, tab: tabs[t], index: forloop.index0 %}
        {%- endfor -%}
      {%- else -%}
        {% render 'demo-grid', limit: section.settings.limit, tabs: tabs %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured prints",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Ground", "default": "paper", "options": [
      { "value": "paper", "label": "Paper" }, { "value": "lime", "label": "Lime" }, { "value": "ink", "label": "Ink" }
    ]},
    { "type": "text", "id": "number", "label": "Section number", "default": "01" },
    { "type": "text", "id": "label", "label": "Label", "default": "New in" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New prints. Loud on purpose." },
    { "type": "text", "id": "text", "label": "Text", "default": "Soft stretch bodies. Woven bands that never hide. Pick a print, pick a size, done." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "text", "id": "tabs", "label": "Card tab colours", "info": "Comma separated: yellow, cyan, orange, pink, purple", "default": "cyan,orange,yellow,pink" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all trunks" }
  ],
  "presets": [{ "name": "Featured prints" }]
}
{% endschema %}
