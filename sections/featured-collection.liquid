{%- liquid
  assign coll = section.settings.collection
  comment
    No collection picked: show the store's own products (all trunks), so live stores never show demo cards.
  endcomment
  if coll == blank
    assign coll = collections.all
  endif
  assign limit = section.settings.limit
  assign anchor = section.settings.anchor | default: section.id | handleize
  assign link = section.settings.link | default: coll.url | default: routes.all_products_collection_url
-%}
<section class="newin shop-home" id="{{ anchor }}" aria-labelledby="title-{{ section.id }}">
  <div class="wrap">
    <div class="sec-top">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
        <h2 id="title-{{ section.id }}" style="margin-top:14px">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}<a class="link" href="{{ link }}">{{ section.settings.link_label | escape }} <span class="arrow">→</span></a>{%- endif -%}
    </div>
    <div class="grid">
      {%- if coll != blank and coll.products_count > 0 -%}
        {%- for product in coll.products limit: limit -%}
          {% render 'product-card', product: product, index: forloop.index0 %}
        {%- endfor -%}
      {%- else -%}
        {% render 'product-card', demo: 'maroon', index: 0 %}
        {% render 'product-card', demo: 'yellow', index: 1 %}
        {% render 'product-card', demo: 'navy', index: 2 %}
        {% render 'product-card', demo: 'grey', index: 3 %}
      {%- endif -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <div class="shop-home-cta"><a class="btn btn-ink" href="{{ link }}">{{ section.settings.button_label | escape }} <span class="arrow">→</span></a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product cards",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "new-in", "info": "Links like /#new-in scroll here." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New in" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loud on purpose." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Pick your size and add straight from the card. Hover to see it on." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Until you pick one, the store's products show (all trunks)." },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all trunks" },
    { "type": "url", "id": "link", "label": "Link", "info": "Empty links to the collection." },
    { "type": "text", "id": "button_label", "label": "Button under the cards", "default": "Shop all trunks", "info": "Leave empty to hide the button." }
  ],
  "presets": [{ "name": "Product cards" }]
}
{% endschema %}
