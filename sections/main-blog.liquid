<section class="page-hero scheme-ink">
  <div class="container">
    <p class="t-label section-head__label"><span class="num">{{ blog.articles_count }}</span> {{ 'blog.stories' | t }}</p>
    <h1 class="t-display page-hero__title" style="color: var(--lime)">{{ blog.title }}</h1>
  </div>
</section>
<section class="section scheme-paper">
  <div class="container">
    {%- paginate blog.articles by 9 -%}
      <div class="blog-grid">
        {%- for article in blog.articles -%}
          <a class="post-card reveal" href="{{ article.url }}" style="--i: {{ forloop.index0 | modulo: 3 }}">
            <figure class="post-card__media">
              {%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 90vw' }}{%- else -%}<img src="{{ 'photo-beach.jpg' | asset_url }}" alt="" loading="lazy">{%- endif -%}
            </figure>
            <p class="t-label">{{ article.published_at | date: '%d %b %Y' }}</p>
            <h2 class="post-card__title">{{ article.title }}</h2>
            <p class="t-body">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
          </a>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}{ "name": "Blog" }{% endschema %}
