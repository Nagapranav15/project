{%- comment -%}
  What goes into a trunk: a photo with pulsing hotspots and a numbered list beside it. Hover or tap either one
  and both light up, with the detail shown on the photo.
{%- endcomment -%}
<section class="pd" data-details>
  <div class="wrap">
    <div class="pd-head">
      <span class="eyebrow"><i></i>{{ section.settings.eyebrow | escape }}</span>
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>
    <div class="pd-grid">
      <div class="pd-photo">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: alt: section.settings.image.alt, loading: 'lazy', widths: '600, 900, 1200, 1400' }}
        {%- else -%}
          <img src="{{ 'trunk-navy-wide.jpg' | asset_url }}" alt="" width="576" height="720" loading="lazy">
        {%- endif -%}
        {%- for block in section.blocks -%}
          <button type="button" class="pd-dot" style="left: {{ block.settings.x }}%; top: {{ block.settings.y }}%" data-detail="{{ forloop.index0 }}" aria-label="{{ block.settings.title | escape }}" data-cursor="{{ block.settings.title | escape }}" {{ block.shopify_attributes }}><span>{{ forloop.index }}</span></button>
        {%- endfor -%}
        <div class="pd-tip" data-detail-tip aria-hidden="true"></div>
      </div>
      <ol class="pd-list">
        {%- for block in section.blocks -%}
          <li data-detail="{{ forloop.index0 }}" tabindex="0">
            <span class="pd-n">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            <div><b>{{ block.settings.title | escape }}</b><p>{{ block.settings.text | escape }}</p></div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product details",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What's in a Jumper" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built to move. Made to be seen." },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "Every trunk, every colour, the same good bones." },
    { "type": "image_picker", "id": "image", "label": "Photo" }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Detail",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Woven waistband" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Soft on the inside, loud on the outside." },
        { "type": "range", "id": "x", "label": "Dot across (%)", "min": 0, "max": 100, "step": 1, "default": 50 },
        { "type": "range", "id": "y", "label": "Dot down (%)", "min": 0, "max": 100, "step": 1, "default": 50 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product details",
      "blocks": [
        { "type": "detail", "settings": { "title": "Woven waistband", "x": 52, "y": 64 } },
        { "type": "detail", "settings": { "title": "Soft stretch body", "text": "95% cotton, 5% elastane.", "x": 55, "y": 74 } }
      ]
    }
  ]
}
{% endschema %}
