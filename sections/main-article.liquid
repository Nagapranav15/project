{%- assign title = article.title | escape -%}
{%- capture meta -%}<span>{{ article.published_at | date: '%d %b %Y' }}</span>{%- if section.settings.show_author -%}<span>{{ 'blog.by' | t: author: article.author }}</span>{%- endif -%}{%- endcapture -%}
{%- capture crumbs -%}<a href="{{ blog.url }}">{{ blog.title | escape }}</a>{%- endcapture -%}
{% render 'page-hero', eyebrow: section.settings.eyebrow, title: title, meta: meta, badge: false, crumbs: crumbs %}
<section class="prose" style="padding-top:0">
  <div class="wrap">
    {%- if article.image -%}<div class="art-hero-img">{{ article.image | image_url: width: 1600 | image_tag: alt: article.image.alt, widths: '600, 900, 1200, 1600', sizes: '(max-width: 900px) 100vw, 860px' }}</div>{%- endif -%}
    <div class="rte" style="margin-top:56px">{{ article.content }}</div>
    {%- if article.tags.size > 0 -%}
      <div class="art-tags">{%- for tg in article.tags -%}<a href="{{ blog.url }}/tagged/{{ tg | handle }}">{{ tg | escape }}</a>{%- endfor -%}</div>
    {%- endif -%}
    <div class="art-foot">
      <a class="link" href="{{ blog.url }}"><span class="arrow">←</span> {{ 'blog.back' | t: title: blog.title }}</a>
      <a class="link" href="https://twitter.com/intent/tweet?url={{ request.origin | append: article.url | url_encode }}" target="_blank" rel="noopener">Share</a>
    </div>

    {%- if blog.comments_enabled? -%}
      <div class="comments">
        <h2 style="font-size:32px">{{ 'blog.comments' | t: count: article.comments_count }}</h2>
        {%- paginate article.comments by 20 -%}
          {%- for comment in article.comments -%}
            <div class="comment"><div class="rte">{{ comment.content }}</div><small>{{ comment.author | escape }} · {{ comment.created_at | date: '%d %b %Y' }}</small></div>
          {%- endfor -%}
          {% render 'pager', paginate: paginate %}
        {%- endpaginate -%}
        <div class="panel" style="margin-top:24px">
          <h2>{{ 'blog.leave_comment' | t }}</h2>
          {%- form 'new_comment', article, class: 'fx' -%}
            {%- if form.posted_successfully? -%}
              <p class="ok" role="status">{% if blog.moderated? %}{{ 'blog.moderated' | t }}{% else %}{{ 'blog.posted' | t }}{% endif %}</p>
            {%- endif -%}
            {%- if form.errors -%}<div class="err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
            <div class="row2">
              <label>{{ 'blog.name' | t }}<input type="text" name="comment[author]" value="{{ form.author }}" required autocomplete="name"></label>
              <label>{{ 'blog.email' | t }}<input type="email" name="comment[email]" value="{{ form.email }}" required autocomplete="email"></label>
            </div>
            <label>{{ 'blog.message' | t }}<textarea name="comment[body]" required>{{ form.body }}</textarea></label>
            {%- if blog.moderated? -%}<small style="color:var(--muted)">{{ 'blog.moderated_note' | t }}</small>{%- endif -%}
            <div class="actions"><button class="btn btn-ink" type="submit">{{ 'blog.post' | t }} <span class="arrow">→</span></button></div>
          {%- endform -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Journal" },
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": true }
  ]
}
{% endschema %}
