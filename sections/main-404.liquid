<section class="lost scheme-lime">
  <div class="container">
    <p class="lost__code" aria-hidden="true">404</p>
    {% render 'character', name: 'wink', class: 'lost__char' %}
    <h1 class="t-headline">{{ 'general.404_title' | t }}</h1>
    <p class="t-body" style="margin: 16px auto 32px">{{ 'general.404_text' | t }}</p>
    <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }} {% render 'icon', icon: 'arrow' %}</a>
  </div>
</section>
{% schema %}{ "name": "404" }{% endschema %}
