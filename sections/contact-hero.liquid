{%- comment -%}
  Contact page header on lime, in the home hero's style: stacked headline on the left, a pile of tilted
  sticker cards (one per way to reach us) on the right. Cards straighten up and lift when hovered.
{%- endcomment -%}
<section class="chero">
  <div class="wrap">
    <div class="chero-copy">
      <span class="eyebrow"><i></i>{{ section.settings.eyebrow | escape }}</span>
      <h1>
        <span class="line"><span>{{ section.settings.line_1 | escape }}</span></span>
        {%- if section.settings.line_2 != blank -%}<span class="line"><span>{{ section.settings.line_2 | escape }}</span></span>{%- endif -%}
      </h1>
      {%- if section.settings.lede != blank -%}<p class="lede">{{ section.settings.lede | escape }}</p>{%- endif -%}
      {%- if section.settings.status != blank -%}<span class="chero-status"><i></i>{{ section.settings.status | escape }}</span>{%- endif -%}
    </div>
    <div class="chero-cards">
      {%- for block in section.blocks -%}
        {%- liquid
          assign value = block.settings.value
          if block.settings.kind == 'email' and value == blank
            assign value = shop.email
          elsif block.settings.kind == 'phone' and value == blank
            assign value = shop.phone
          endif
          assign href = block.settings.link
          if href == blank
            case block.settings.kind
              when 'email'
                assign href = 'mailto:' | append: value
              when 'phone'
                assign href = 'tel:' | append: value | remove: ' '
              when 'whatsapp'
                assign digits = value | remove: ' ' | remove: '+' | remove: '-'
                assign href = 'https://wa.me/' | append: digits
              when 'visit'
                assign q = value | url_encode
                assign href = 'https://www.google.com/maps/search/?api=1&query=' | append: q
            endcase
          endif
          comment
            An Instagram card whose link is empty or just instagram.com goes to the handle written on the card.
          endcomment
          if block.settings.kind == 'instagram' and value contains '@'
            assign bare = href | remove: 'https://' | remove: 'http://' | remove: 'www.' | remove: '/'
            if href == blank or bare == 'instagram.com'
              assign handle = value | remove: '@' | strip
              assign href = 'https://instagram.com/' | append: handle
            endif
          endif
        -%}
        {%- if value != blank -%}
          <a class="chero-card" href="{{ href }}" style="--c: var(--{{ block.settings.colour }}); --r: {% cycle '-5', '4', '-3', '6' %}deg"{% if block.settings.kind == 'instagram' or block.settings.kind == 'whatsapp' or block.settings.kind == 'visit' %} target="_blank" rel="noopener"{% endif %} data-cursor="{{ block.settings.cursor | escape }}" {{ block.shopify_attributes }}>
            <span class="chero-ico" aria-hidden="true">
              {%- case block.settings.kind -%}
                {%- when 'email' -%}<svg viewBox="0 0 24 24"><path d="M3 5h18v14H3z" fill="none" stroke="currentColor" stroke-width="2"/><path d="m3 6 9 7 9-7" fill="none" stroke="currentColor" stroke-width="2"/></svg>
                {%- when 'phone' -%}<svg viewBox="0 0 24 24"><path d="M6 3h4l2 5-3 2a12 12 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A18 18 0 0 1 4 5a2 2 0 0 1 2-2z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
                {%- when 'whatsapp' -%}<svg viewBox="0 0 24 24"><path d="M4 20l1.3-4A8 8 0 1 1 8 19z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M9 9c0 3 3 6 6 6l1-1.5-2-1-1 .8c-1-.4-2-1.4-2.3-2.3l.8-1-1-2z" fill="currentColor"/></svg>
                {%- when 'instagram' -%}<svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.3" fill="currentColor"/></svg>
                {%- else -%}<svg viewBox="0 0 24 24"><path d="M12 21s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="9" r="2.5" fill="currentColor"/></svg>
              {%- endcase -%}
            </span>
            <span class="chero-label">{{ block.settings.label | escape }}</span>
            <span class="chero-value">{%- if block.settings.kind == 'email' -%}{{ value | escape | replace: '@', '@<wbr>' }}{%- else -%}{{ value | escape }}{%- endif -%}</span>
            {%- if block.settings.note != blank -%}<span class="chero-note">{{ block.settings.note | escape }}</span>{%- endif -%}
            <span class="chero-go" aria-hidden="true">→</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact: header",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Contact" },
    { "type": "text", "id": "line_1", "label": "Line 1", "default": "Say hi." },
    { "type": "text", "id": "line_2", "label": "Line 2", "default": "We don't bite." },
    { "type": "textarea", "id": "lede", "label": "Intro", "default": "Sizing, exchanges, a pack gone missing or just a compliment for the band. A real human answers." },
    { "type": "text", "id": "status", "label": "Reply time", "default": "Replies in under 24 hours" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Contact card",
      "settings": [
        { "type": "select", "id": "kind", "label": "Type", "default": "email", "options": [
          { "value": "email", "label": "Email" },
          { "value": "phone", "label": "Phone" },
          { "value": "whatsapp", "label": "WhatsApp" },
          { "value": "instagram", "label": "Instagram" },
          { "value": "visit", "label": "Address" }
        ] },
        { "type": "text", "id": "label", "label": "Label", "default": "Email us" },
        { "type": "text", "id": "value", "label": "Value", "info": "Email and phone fall back to the store's own details when left empty." },
        { "type": "url", "id": "link", "label": "Link", "info": "Optional. Email, phone and WhatsApp make their own links." },
        { "type": "text", "id": "note", "label": "Small print" },
        { "type": "text", "id": "cursor", "label": "Cursor label", "default": "Say hi" },
        { "type": "select", "id": "colour", "label": "Colour", "default": "pink", "options": [
          { "value": "pink", "label": "Pink" },
          { "value": "cyan", "label": "Cyan" },
          { "value": "orange", "label": "Orange" },
          { "value": "yellow", "label": "Yellow" },
          { "value": "paper", "label": "Paper" }
        ] }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact: header",
      "blocks": [
        { "type": "card", "settings": { "kind": "email", "label": "Email us", "colour": "pink" } },
        { "type": "card", "settings": { "kind": "instagram", "label": "Slide into our DMs", "value": "@jumper", "colour": "cyan" } }
      ]
    }
  ]
}
{% endschema %}
