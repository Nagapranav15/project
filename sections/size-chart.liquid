{%- comment -%}
  Size chart with a size finder: slide to your waist and the matching row lights up with a verdict.
  Shown in inches (sizes are entered in cm in the editor and converted). Linked from the product page's "Size guide" as #size-chart.
{%- endcomment -%}
<section class="sz" id="size-chart" data-size-chart data-result="{{ section.settings.result_text | escape }}" data-between="{{ section.settings.between_text | escape }}" data-none="{{ section.settings.none_text | escape }}">
  <div class="wrap sz-grid">
    <div class="sz-copy">
      <span class="eyebrow"><i></i>{{ section.settings.eyebrow | escape }}</span>
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="sz-lede">{{ section.settings.text | escape }}</p>{%- endif -%}
      <div class="sz-finder">
        <label for="szRange-{{ section.id }}">{{ section.settings.finder_label | escape }} <output data-sz-out>31.5 in</output></label>
        <input type="range" id="szRange-{{ section.id }}" min="24" max="46" value="31.5" step="0.5" data-sz-range>
        <p class="sz-result" data-sz-result aria-live="polite"></p>
      </div>
      <ol class="sz-how">
        <li><b>{{ section.settings.waist_title | escape }}</b> {{ section.settings.waist_how | escape }}</li>
        <li><b>{{ section.settings.hip_title | escape }}</b> {{ section.settings.hip_how | escape }}</li>
      </ol>
    </div>
    <div class="sz-card">
      <table class="sz-table">
        <thead><tr><th scope="col">{{ section.settings.col_size | escape }}</th><th scope="col">{{ section.settings.col_waist | escape }}</th><th scope="col">{{ section.settings.col_hip | escape }}</th><th scope="col">{{ section.settings.col_jeans | escape }}</th></tr></thead>
        <tbody>
          {%- for block in section.blocks -%}
            {%- liquid
              assign s = block.settings
              assign wmin_in = s.waist_min | divided_by: 2.54 | round: 1 | append: '' | replace: '.0', ''
              assign wmax_in = s.waist_max | divided_by: 2.54 | round: 1 | append: '' | replace: '.0', ''
              assign hmin_in = s.hip_min | divided_by: 2.54 | round: 1 | append: '' | replace: '.0', ''
              assign hmax_in = s.hip_max | divided_by: 2.54 | round: 1 | append: '' | replace: '.0', ''
            -%}
            <tr data-size="{{ s.label | escape }}" data-wmin="{{ s.waist_min }}" data-wmax="{{ s.waist_max }}" {{ block.shopify_attributes }}>
              <th scope="row"><span class="sz-tag">{{ s.label | escape }}</span></th>
              <td>{{ wmin_in }}–{{ wmax_in }}</td>
              <td>{{ hmin_in }}–{{ hmax_in }}</td>
              <td>{{ s.jeans | escape }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
      <figure class="sz-photo" style="--wy: {{ section.settings.waist_y }}%; --hy: {{ section.settings.hip_y }}%; --pos: {{ section.settings.photo_y }}%">
        {%- if section.settings.photo != blank -%}
          {{ section.settings.photo | image_url: width: 1000 | image_tag: alt: section.settings.photo.alt, loading: 'lazy', widths: '500, 750, 1000' }}
        {%- else -%}
          <img src="{{ 'trunk-yellow-close.jpg' | asset_url }}" alt="" width="576" height="720" loading="lazy">
        {%- endif -%}
        <span class="sz-mark sz-mark--waist"><b>{{ section.settings.col_waist | escape }}</b></span>
        <span class="sz-mark sz-mark--hip"><b>{{ section.settings.col_hip | escape }}</b></span>
      </figure>
      {%- if section.settings.note != blank -%}<p class="sz-note">{{ section.settings.note | escape }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Size chart",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Size chart" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your fit." },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "True to size, cut to stay put. Slide to your waist and we will call it." },
    { "type": "text", "id": "finder_label", "label": "Finder label", "default": "Your waist" },
    { "type": "text", "id": "result_text", "label": "Result", "default": "You're a [[size]]. Snug, not squeezy.", "info": "[[size]] becomes the size." },
    { "type": "text", "id": "between_text", "label": "Between sizes", "default": "Right between [[size]] and [[next]]. Size up for room, down for hold." },
    { "type": "text", "id": "none_text", "label": "Outside the chart", "default": "Off the chart. Write in and we will help you pick." },
    { "type": "text", "id": "waist_title", "label": "Waist title", "default": "Waist." },
    { "type": "text", "id": "waist_how", "label": "How to measure the waist", "default": "Round the narrowest part, just above the belly button. Tape snug, not tight." },
    { "type": "text", "id": "hip_title", "label": "Hip title", "default": "Hip." },
    { "type": "text", "id": "hip_how", "label": "How to measure the hip", "default": "Round the fullest part of your seat, feet together." },
    { "type": "text", "id": "col_size", "label": "Size column", "default": "Size" },
    { "type": "text", "id": "col_waist", "label": "Waist column", "default": "Waist" },
    { "type": "text", "id": "col_hip", "label": "Hip column", "default": "Hip" },
    { "type": "text", "id": "col_jeans", "label": "Jeans column", "default": "Jeans" },
    { "type": "text", "id": "note", "label": "Small print", "default": "Measurements are body measurements. Fabric has 4-way stretch." },
    { "type": "header", "content": "Measuring photo" },
    { "type": "image_picker", "id": "photo", "label": "Photo", "info": "A front-on shot of the trunks works best. Empty uses the Sunshine trunk photo." },
    { "type": "range", "id": "photo_y", "label": "Photo crop (up and down)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 44 },
    { "type": "range", "id": "waist_y", "label": "Waist line height", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 24 },
    { "type": "range", "id": "hip_y", "label": "Hip line height", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 55 }
  ],
  "blocks": [
    {
      "type": "size",
      "name": "Size",
      "settings": [
        { "type": "text", "id": "label", "label": "Size", "default": "M" },
        { "type": "number", "id": "waist_min", "label": "Waist from (cm)", "info": "Enter in cm. The page shows inches.", "default": 79 },
        { "type": "number", "id": "waist_max", "label": "Waist to (cm)", "default": 86 },
        { "type": "number", "id": "hip_min", "label": "Hip from (cm)", "default": 94 },
        { "type": "number", "id": "hip_max", "label": "Hip to (cm)", "default": 101 },
        { "type": "text", "id": "jeans", "label": "Jeans size", "default": "31–32" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Size chart",
      "blocks": [
        { "type": "size", "settings": { "label": "S", "waist_min": 71, "waist_max": 78, "hip_min": 86, "hip_max": 93, "jeans": "28–30" } },
        { "type": "size", "settings": { "label": "M", "waist_min": 79, "waist_max": 86, "hip_min": 94, "hip_max": 101, "jeans": "31–32" } },
        { "type": "size", "settings": { "label": "L", "waist_min": 87, "waist_max": 94, "hip_min": 102, "hip_max": 109, "jeans": "33–34" } },
        { "type": "size", "settings": { "label": "XL", "waist_min": 95, "waist_max": 102, "hip_min": 110, "hip_max": 117, "jeans": "36–38" } }
      ]
    }
  ]
}
{% endschema %}
