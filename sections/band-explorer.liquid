{%- comment -%} The waistband is the brand billboard. Interactive index of band constructions. {%- endcomment -%}
<section class="section scheme-ink bands" id="bands" data-bands>
  <div class="container bands__grid">
    <div class="bands__intro">
      <p class="t-label section-head__label reveal"><span class="num">{{ section.settings.number }}</span> {{ section.settings.label }}</p>
      <h2 class="t-headline bands__title reveal" style="--d: 1">{{ section.settings.heading }}</h2>
      <p class="t-body bands__text reveal" style="--d: 2">{{ section.settings.text }}</p>
    </div>

    <div class="bands__viewer window reveal" style="--d: 2">
      <div class="window__bar">
        <span class="window__dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="t-label" data-band-file>band_01.jpg</span>
        <span class="t-label window__meta" data-band-count>01 / {{ section.blocks.size | prepend: '0' | slice: -2, 2 }}</span>
      </div>
      <div class="bands__stage">
        {%- for block in section.blocks -%}
          <figure class="bands__slide{% if forloop.first %} is-active{% endif %}" data-band-slide="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {% render 'image', image: block.settings.image, fallback: block.settings.fallback, alt: block.settings.title, class: 'bands__img', sizes: '(min-width: 990px) 50vw, 100vw' %}
          </figure>
        {%- endfor -%}
        <span class="chip chip--lime bands__chip" data-band-chip>{{ section.blocks.first.settings.title }}</span>
      </div>
    </div>

    <ol class="bands__list" role="list">
      {%- for block in section.blocks -%}
        <li>
          <button class="bands__row{% if forloop.first %} is-active{% endif %}" type="button" data-band-trigger="{{ forloop.index0 }}" data-title="{{ block.settings.title | escape }}" aria-pressed="{{ forloop.first }}">
            <span class="t-label bands__idx">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="bands__name">{{ block.settings.title }}</span>
            <span class="t-label bands__type">{{ block.settings.type }}</span>
            <span class="bands__swatch" style="--sw: var(--{{ block.settings.swatch }})"></span>
          </button>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Waistband explorer",
  "settings": [
    { "type": "text", "id": "number", "label": "Section number", "default": "02" },
    { "type": "text", "id": "label", "label": "Label", "default": "Waistband signature" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The band is the billboard." },
    { "type": "text", "id": "text", "label": "Text", "default": "Wordmark front and centre, repeated across the band. Waistband peeking, never hidden." }
  ],
  "blocks": [
    {
      "type": "band",
      "name": "Band",
      "settings": [
        { "type": "text", "id": "title", "label": "Name", "default": "Blue camo print" },
        { "type": "text", "id": "type", "label": "Construction", "default": "Print" },
        { "type": "image_picker", "id": "image", "label": "Macro photo" },
        { "type": "select", "id": "fallback", "label": "Bundled band photo", "default": "band-blue-camo.jpg", "options": [
          { "value": "band-black-orange-piping.jpg", "label": "Black elastic, orange piping" },
          { "value": "band-orange-mesh.jpg", "label": "Orange woven mesh" },
          { "value": "band-navy-repeat.jpg", "label": "Navy woven repeat" },
          { "value": "band-black-woven.jpg", "label": "Black woven label" },
          { "value": "band-blue-camo.jpg", "label": "Blue camo print" },
          { "value": "band-orange-wave.jpg", "label": "Orange wave print" },
          { "value": "band-lime-shadow.jpg", "label": "Lime shadow camo print" },
          { "value": "band-white-elastic.jpg", "label": "White elastic, Ink wordmark" }
        ]},
        { "type": "select", "id": "swatch", "label": "Swatch", "default": "cyan", "options": [
          { "value": "lime", "label": "Lime" }, { "value": "ink", "label": "Ink" }, { "value": "paper", "label": "Paper" },
          { "value": "yellow", "label": "Yellow" }, { "value": "cyan", "label": "Cyan" }, { "value": "orange", "label": "Orange" },
          { "value": "pink", "label": "Pink" }, { "value": "purple", "label": "Purple" }
        ]}
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [{ "name": "Waistband explorer", "blocks": [{ "type": "band" }] }]
}
{% endschema %}
