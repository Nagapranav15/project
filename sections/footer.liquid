<footer class="footer scheme-ink">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        {% render 'logo-icon-j', class: 'footer__icon' %}
        <p class="t-subhead">{{ section.settings.tagline }}</p>
        <ul class="footer__social" role="list">
          {%- if settings.social_instagram != blank -%}<li><a class="icon-btn" href="{{ settings.social_instagram }}" aria-label="Instagram">{% render 'icon', icon: 'instagram' %}</a></li>{%- endif -%}
          {%- if settings.social_youtube != blank -%}<li><a class="icon-btn" href="{{ settings.social_youtube }}" aria-label="YouTube">{% render 'icon', icon: 'youtube' %}</a></li>{%- endif -%}
        </ul>
      </div>
      {%- for block in section.blocks -%}
        <div class="footer__col" {{ block.shopify_attributes }}>
          <p class="t-label footer__heading">{{ block.settings.heading }}</p>
          {%- case block.type -%}
            {%- when 'menu' -%}
              {%- assign menu = linklists[block.settings.menu] -%}
              <ul role="list">
                {%- if menu.links.size > 0 -%}
                  {%- for link in menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
                {%- else -%}
                  {%- assign fb = block.settings.fallback | split: ',' -%}
                  {%- for t in fb -%}<li><a href="{{ routes.all_products_collection_url }}">{{ t | strip }}</a></li>{%- endfor -%}
                {%- endif -%}
              </ul>
            {%- when 'text' -%}
              <div class="footer__text">{{ block.settings.text }}</div>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <a class="footer__mark" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {% render 'logo-wordmark', class: 'footer__wordmark' %}
    </a>

    <div class="footer__bottom">
      <p class="t-label">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} &middot; {{ powered_by_link }}</p>
      <p class="t-label footer__sign">{% render 'sparkle', class: 'footer__spark' %} {{ section.settings.signoff }}</p>
      {%- if section.settings.show_payment -%}
        <ul class="footer__pay" role="list">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'footer__pay-icon' }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Underwear with the volume up." },
    { "type": "text", "id": "signoff", "label": "Sign-off", "default": "Stay cheeky, never crude." },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    { "type": "menu", "name": "Menu", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
      { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" },
      { "type": "text", "id": "fallback", "label": "Placeholder links (shown until a menu is chosen)", "default": "Trunks,Briefs,Prints,Packs" }
    ]},
    { "type": "text", "name": "Text", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Help" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Free shipping all India. Easy 15-day exchanges on unworn packs.</p>" }
    ]}
  ],
  "max_blocks": 4
}
{% endschema %}
