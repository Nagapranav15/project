<footer class="site-footer">
  <div class="container">
    <div class="footer-top-grid">
      <div class="footer-brand-col">
        <a href="{{ routes.root_url }}" class="brand-logo">
          <span class="text-gradient-chrome">{{ section.settings.logo_text | default: 'JUMPER' }}</span>
          <span class="brand-logo-badge">{{ section.settings.badge_text | default: 'CYBER 2.0' }}</span>
        </a>
        <p>
          {{ section.settings.about_text | default: 'Reinventing modern undergarments through Austrian MicroModal engineering and futuristic streetwear design.' }}
        </p>
        <div style="display:flex; gap:1rem;">
          <a href="#" class="action-btn" aria-label="Instagram"><i data-lucide="instagram" style="width:18px;height:18px;"></i></a>
          <a href="#" class="action-btn" aria-label="Twitter"><i data-lucide="twitter" style="width:18px;height:18px;"></i></a>
          <a href="#" class="action-btn" aria-label="Youtube"><i data-lucide="youtube" style="width:18px;height:18px;"></i></a>
        </div>
      </div>

      <div>
        <h4 class="footer-col-title">Shop</h4>
        <ul class="footer-links">
          <li><a href="#shop">Cyber Trunks</a></li>
          <li><a href="#shop">Relaxed Boxers</a></li>
          <li><a href="#shop">Sport Briefs</a></li>
          <li><a href="#bundle-builder">Custom Bundles</a></li>
          <li><a href="#shop">Gift Cards</a></li>
        </ul>
      </div>

      <div>
        <h4 class="footer-col-title">Tech & Ethics</h4>
        <ul class="footer-links">
          <li><a href="#fabric-story">MicroModal Science</a></li>
          <li><a href="#fabric-story">Zero Carbon Closed-Loop</a></li>
          <li><a href="#">OEKO-TEX Certification</a></li>
          <li><a href="#">Fit Guarantee</a></li>
          <li><a href="#">Size Calculator</a></li>
        </ul>
      </div>

      <div>
        <h4 class="footer-col-title">Join The Cyber Lab</h4>
        <p style="font-size:0.85rem; color:var(--text-muted); margin-bottom:1rem;">
          Receive secret drop codes, early access to limited cyber colorways, and VIP perks.
        </p>
        <form class="newsletter-form" onsubmit="event.preventDefault(); window.themeCart?.showToast('⚡ Welcome to the Cyber VIP List!');">
          <input type="email" placeholder="Enter cyber email..." required class="newsletter-input">
          <button type="submit" class="btn btn-primary btn-pill">Join</button>
        </form>
      </div>
    </div>

    <div style="padding-top:2rem; border-top:1px solid var(--surface-border); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; font-size:0.8rem; color:var(--text-subtle);">
      <div>© {{ 'now' | date: '%Y' }} JUMPER CYBERWEAR INC. ALL RIGHTS RESERVED.</div>
      <div>SHOPIFY 2.0 PRODUCTION READY ARCHITECTURE</div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo Text", "default": "JUMPER" },
    { "type": "text", "id": "badge_text", "label": "Badge Text", "default": "CYBER 2.0" },
    { "type": "textarea", "id": "about_text", "label": "About Text", "default": "Reinventing modern undergarments through Austrian MicroModal engineering and futuristic streetwear design." }
  ]
}
{% endschema %}
