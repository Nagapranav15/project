{%- assign title = section.settings.title | escape -%}
{% render 'page-hero', eyebrow: section.settings.eyebrow, title: title, badge: true %}
<section class="coll">
  <div class="wrap">
    <div class="tiles">
      {%- for c in collections -%}
        {%- assign i = forloop.index0 | modulo: 4 -%}
        <a class="tile" href="{{ c.url }}" style="--spark:{% case i %}{% when 0 %}var(--pink){% when 1 %}var(--cyan){% when 2 %}var(--orange){% else %}var(--purple){% endcase %}">
          <div class="media">
            {%- if c.featured_image -%}{{ c.featured_image | image_url: width: 900 | image_tag: alt: '', loading: 'lazy', widths: '400, 600, 900', sizes: '(max-width: 560px) 100vw, 33vw' }}{%- else -%}<span class="ph">{% render 'mark' %}</span>{%- endif -%}
          </div>
          <div class="info"><h2>{{ c.title | escape }}</h2><span>{{ 'collections.count' | t: count: c.products_count }}</span></div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop" },
    { "type": "text", "id": "title", "label": "Heading", "default": "All collections" }
  ]
}
{% endschema %}
