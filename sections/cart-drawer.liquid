<div class="cart-drawer-backdrop"></div>
<div class="cart-drawer">
  <div class="cart-header">
    <div style="display:flex; align-items:center; gap:0.6rem;">
      <i data-lucide="shopping-bag" style="color:var(--neon-lime);"></i>
      <h3 style="font-size:1.2rem; font-weight:800; letter-spacing:0.05em;">YOUR CYBER BAG</h3>
    </div>
    <button class="action-btn" data-close-cart aria-label="Close Cart" style="width:36px; height:36px;">
      <i data-lucide="x" style="width:16px;height:16px;"></i>
    </button>
  </div>

  <!-- Tiered Free Shipping Bar -->
  <div class="cart-free-shipping">
    <div class="free-shipping-text" style="font-size:0.82rem; color:var(--white);">
      Add <strong>$43.00</strong> more for <strong>FREE EXPRESS SHIPPING</strong>
    </div>
    <div class="free-shipping-bar">
      <div class="free-shipping-fill"></div>
    </div>
  </div>

  <!-- Items List -->
  <div class="cart-items-list">
    <!-- Rendered dynamically by ThemeCart -->
  </div>

  <!-- Footer & Checkout -->
  <div class="cart-footer">
    <div class="cart-subtotal-row">
      <span>SUBTOTAL</span>
      <span class="cart-subtotal-price text-gradient-chrome">{{ cart.total_price | money }}</span>
    </div>
    <p style="font-size:0.75rem; color:var(--text-muted); text-align:center;">
      Taxes & carbon-neutral express shipping calculated at checkout.
    </p>
    <form action="{{ routes.cart_url }}" method="post">
      <button type="submit" name="checkout" class="btn btn-primary" style="width:100%;">
        <span>Proceed To Checkout</span>
        <i data-lucide="lock" style="width:16px;height:16px;"></i>
      </button>
    </form>
  </div>
</div>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": []
}
{% endschema %}
