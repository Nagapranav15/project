{%- comment -%}
  Bag drawer. Static section so the Section Rendering API can refresh it after every add, change and remove.
  Pack lines (line item property _pack) are grouped into one row with colour stripes, like the homepage draft.
  The bag data below feeds the packing screen that plays when someone taps Checkout (snippets/packing.liquid).
{%- endcomment -%}
<aside class="drawer" id="drawer" aria-label="{{ 'cart.title' | t }}" aria-hidden="true">
  <div class="dhead"><h2>{{ 'cart.title' | t }}</h2><button class="menu-close" type="button" id="drawerClose">{{ 'accessibility.close' | t }}</button></div>
  <div class="drawer-body" id="drawerBody" data-count="{{ cart.item_count }}">
    {%- if settings.cart_show_box -%}
      <script type="application/json" data-box-data>{ "items": [
        {%- for item in cart.items -%}
          {%- liquid
            assign box_hex = item.properties['_hex']
            if box_hex == blank
              assign box_hex = item.product.metafields.custom.swatch.value | default: item.product.metafields.custom.swatch
            endif
          -%}
          { "key": {{ item.key | json }}, "qty": {{ item.quantity }}, "hex": {{ box_hex | default: '#777777' | json }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ] }</script>
    {%- endif -%}
    {% render 'cart-meter' %}
    <div class="items" id="items">
      {%- if cart.item_count == 0 -%}
        <div class="empty"><b>{{ 'cart.empty_line_1' | t }}<br>{{ 'cart.empty_line_2' | t }}</b><a class="btn btn-ink" href="{{ routes.all_products_collection_url }}" data-closebag>{{ 'cart.shop' | t }} <span class="arrow">→</span></a></div>
      {%- else -%}
        {%- liquid
          assign pack_ids = ''
          for item in cart.items
            assign pid = item.properties['_pack']
            if pid != blank
              assign token = '|' | append: pid | append: '|'
              unless pack_ids contains token
                assign pack_ids = pack_ids | append: token
              endunless
            endif
          endfor
          assign pack_list = pack_ids | split: '|'
        -%}
        {%- for pid in pack_list -%}
          {%- if pid == blank -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign p_total = 0
            assign p_orig = 0
            assign p_keys = ''
            assign p_names = ''
            assign p_label = ''
            assign p_size = ''
            assign p_stripes = ''
            for item in cart.items
              if item.properties['_pack'] == pid
                assign p_total = p_total | plus: item.final_line_price
                assign p_orig = p_orig | plus: item.original_line_price
                assign p_keys = p_keys | append: item.key | append: ','
                assign p_label = item.properties['Pack'] | default: p_label
                assign p_size = item.properties['_size'] | default: p_size
                assign hex = item.properties['_hex'] | default: '#777777'
                for q in (1..item.quantity)
                  assign p_stripes = p_stripes | append: '<i style="background:' | append: hex | append: '"></i>'
                  assign nm = item.properties['_name'] | default: item.product.title
                  assign p_names = p_names | append: nm | append: ', '
                endfor
              endif
            endfor
            assign p_names = p_names | split: ', ' | join: ', '
          -%}
          <div class="item">
            <div class="thumb">{{ p_stripes }}</div>
            <div><b>{{ p_label | default: 'Pack' | escape }}</b><small>{{ p_names | escape }}{% if p_size != blank %} · {{ 'cart.pack_size' | t: size: p_size }}{% endif %}</small></div>
            <div style="text-align:right">
              <b>{{ p_total | money_without_trailing_zeros }}</b>
              {%- if p_orig > p_total -%}<span class="was">{{ p_orig | money_without_trailing_zeros }}</span>{%- endif -%}
              <button class="rm" type="button" data-rm-pack="{{ p_keys }}">{{ 'cart.remove' | t }}</button>
            </div>
          </div>
        {%- endfor -%}
        {%- for item in cart.items -%}
          {%- if item.properties['_pack'] != blank -%}{%- continue -%}{%- endif -%}
          <div class="item">
            {%- if item.image -%}
              <a href="{{ item.url }}" tabindex="-1">{{ item.image | image_url: width: 160 | image_tag: alt: '', loading: 'lazy', width: 64, height: 80 }}</a>
            {%- else -%}
              <div class="thumb"><i style="background:var(--lime)"></i></div>
            {%- endif -%}
            <div>
              <b><a href="{{ item.url }}" style="text-decoration:none">{{ item.product.title | escape }}</a></b>
              <small class="opts">
                {%- unless item.product.has_only_default_variant -%}
                  {%- for o in item.options_with_values -%}{{ o.name | escape }} {{ o.value | escape }}{% unless forloop.last %} · {% endunless %}{%- endfor -%}
                {%- endunless -%}
                {%- for p in item.properties -%}
                  {%- assign first = p.first | slice: 0 -%}
                  {%- if p.last != blank and first != '_' -%} · {{ p.first | escape }}: {{ p.last | escape }}{%- endif -%}
                {%- endfor -%}
                {%- if item.selling_plan_allocation -%} · {{ item.selling_plan_allocation.selling_plan.name | escape }}{%- endif -%}
              </small>
              {%- for d in item.line_level_discount_allocations -%}<small class="disc">✦ {{ d.discount_application.title | escape }} (−{{ d.amount | money_without_trailing_zeros }})</small>{%- endfor -%}
              <span class="qty-mini">
                <button type="button" data-qty="{{ item.quantity | minus: 1 }}" data-key="{{ item.key }}" aria-label="{{ 'products.decrease' | t }}">−</button>
                <span>{{ item.quantity }}</span>
                <button type="button" data-qty="{{ item.quantity | plus: 1 }}" data-key="{{ item.key }}" aria-label="{{ 'products.increase' | t }}">+</button>
              </span>
            </div>
            <div style="text-align:right">
              <b>{{ item.final_line_price | money_without_trailing_zeros }}</b>
              {%- if item.original_line_price > item.final_line_price -%}<span class="was">{{ item.original_line_price | money_without_trailing_zeros }}</span>{%- endif -%}
              <button class="rm" type="button" data-qty="0" data-key="{{ item.key }}">{{ 'cart.remove' | t }}</button>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    <div class="dfoot">
      {%- for d in cart.cart_level_discount_applications -%}
        <div class="disc-row"><span>✦ {{ d.title | escape }}</span><span>−{{ d.total_allocated_amount | money_without_trailing_zeros }}</span></div>
      {%- endfor -%}
      <div class="row"><span>{{ 'cart.subtotal' | t }}</span><span id="subtotal">{{ cart.total_price | money_without_trailing_zeros }}</span></div>
      <form action="{{ routes.cart_url }}" method="post" id="drawerCheckout">
        <button class="btn btn-ink" type="submit" name="checkout" id="checkout" style="--spark:var(--lime)"{% if cart.item_count == 0 %} disabled{% endif %}>{{ 'cart.checkout' | t }} <span class="arrow">→</span></button>
      </form>
      <small>{{ settings.cart_note_text | escape }}</small>
      {%- if cart.item_count > 0 -%}<a class="cartlink" href="{{ routes.cart_url }}">{{ 'cart.view_cart' | t }}</a>{%- endif -%}
    </div>
  </div>
</aside>
