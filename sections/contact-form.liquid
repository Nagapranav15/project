<section class="contact-sec">
  <div class="wrap">
    <div>
      <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      <h2 style="margin-top:14px">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text | escape }}</p>{%- endif -%}
      <div class="chips">
        {%- if shop.email != blank -%}<a class="chip" href="mailto:{{ shop.email }}" style="text-decoration:none">{{ shop.email }}</a>{%- endif -%}
        {%- if shop.phone != blank -%}<a class="chip" href="tel:{{ shop.phone | remove: ' ' }}" style="text-decoration:none">{{ shop.phone }}</a>{%- endif -%}
      </div>
    </div>
    <div class="panel">
      {%- form 'contact', class: 'fx' -%}
        {%- if form.posted_successfully? -%}<p class="ok" role="status">{{ 'contact.success' | t }}</p>{%- endif -%}
        {%- if form.errors -%}<div class="err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="row2">
          <label>{{ 'contact.name' | t }}<input type="text" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"></label>
          <label>{{ 'contact.email' | t }}<input type="email" name="contact[email]" autocomplete="email" required value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"></label>
        </div>
        <label>{{ 'contact.phone' | t }}<input type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}"></label>
        <label>{{ 'contact.message' | t }}<textarea name="contact[body]" required>{{ form.body }}</textarea></label>
        <div class="actions"><button class="btn btn-ink" type="submit">{{ 'contact.send' | t }} <span class="arrow">→</span></button></div>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Help" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk to us." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Sizing, exchanges, a pack gone missing. Write in and a real human answers within a day." }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
