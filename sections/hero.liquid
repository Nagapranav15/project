{%- liquid
  assign lines = section.settings.heading | split: '/'
  assign word_index = 0
-%}
<section class="hero scheme-{{ section.settings.scheme }}" data-hero>
  <div class="hero__grid container">
    <div class="hero__copy">
      <p class="t-label hero__eyebrow reveal">
        <span>{{ section.settings.eyebrow }}</span>
        {% render 'sparkle', class: 'hero__eyespark' %}
        <span>{{ section.settings.eyebrow_2 }}</span>
      </p>

      <h1 class="t-display hero__title" aria-label="{{ section.settings.heading | replace: '/', ' ' | escape }}">
        {%- for line in lines -%}
          <span class="ln" aria-hidden="true">
            {%- assign words = line | strip | split: ' ' -%}
            {%- for w in words -%}
              <span class="word" style="--w: {{ word_index }}">{{ w }}</span>{% unless forloop.last %} {% endunless %}
              {%- assign word_index = word_index | plus: 1 -%}
            {%- endfor -%}
          </span>
        {%- endfor -%}
      </h1>

      <p class="t-subhead hero__sub reveal" style="--d: 4">{{ section.settings.subheading }}</p>
      <div class="t-body hero__text reveal" style="--d: 5">{{ section.settings.text }}</div>

      <div class="hero__ctas reveal" style="--d: 6">
        {%- if section.settings.button_label != blank -%}
          <a class="btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" data-magnetic>
            {{ section.settings.button_label }} {% render 'icon', icon: 'arrow' %}
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a class="link-arrow" href="{{ section.settings.button_2_link | default: '#crew' }}">{{ section.settings.button_2_label }}</a>
        {%- endif -%}
      </div>

      <ul class="hero__pillars reveal" style="--d: 7" role="list">
        <li class="t-label">Movement</li>
        <li class="t-label">Comfort</li>
        <li class="t-label">Confidence</li>
      </ul>
    </div>

    <div class="hero__stage" data-parallax-group>
      <div class="hero__block" data-depth="0.4" aria-hidden="true"></div>
      <figure class="hero__frame" data-depth="1">
        {% render 'image', image: section.settings.image, fallback: section.settings.fallback, alt: section.settings.image_alt, class: 'hero__img', loading: 'eager', sizes: '(min-width: 990px) 40vw, 90vw' %}
      </figure>
      {%- if section.settings.chip != blank -%}
        <span class="chip chip--{{ section.settings.chip_color }} hero__chip" data-depth="1.6">{{ section.settings.chip }}</span>
      {%- endif -%}

      <div class="badge hero__badge" data-depth="2" aria-hidden="true">
        <svg class="badge__ring" viewBox="0 0 200 200">
          <defs><path id="badgePath-{{ section.id }}" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"/></defs>
          <circle cx="100" cy="100" r="100" class="badge__bg"/>
          <text class="badge__text"><textPath href="#badgePath-{{ section.id }}" textLength="488">{{ section.settings.badge_text | upcase }}</textPath></text>
        </svg>
        {% render 'logo-icon-j', class: 'badge__icon' %}
      </div>
      {% render 'sparkle', class: 'hero__spark hero__spark--a' %}
      {% render 'sparkle', class: 'hero__spark hero__spark--b' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero · Wear it loud",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Ground", "default": "lime", "options": [
      { "value": "lime", "label": "Lime (default)" }, { "value": "ink", "label": "Ink" }, { "value": "paper", "label": "Paper" }
    ]},
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Summer trunks" },
    { "type": "text", "id": "eyebrow_2", "label": "Label 2", "default": "Drop 01" },
    { "type": "text", "id": "heading", "label": "Display heading", "info": "Use / for a line break. Keep it short, with a full stop.", "default": "Wear/it/loud." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Underwear with the volume up." },
    { "type": "richtext", "id": "text", "label": "Body", "default": "<p>Soft, stretchy and built for everything the day throws at you. Gym. Office. Rooftop. Same trunks.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop new prints" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button_2_label", "label": "Secondary link label", "default": "Meet the crew" },
    { "type": "url", "id": "button_2_link", "label": "Secondary link" },
    { "type": "header", "content": "Photo" },
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Band first: crop so the waistband reads." },
    { "type": "select", "id": "fallback", "label": "Bundled photo (used when no photo is chosen)", "default": "photo-pool.jpg", "options": [
      { "value": "photo-pool.jpg", "label": "Pool" }, { "value": "photo-beach.jpg", "label": "Beach" }, { "value": "photo-court.jpg", "label": "Court" },
      { "value": "photo-denim.jpg", "label": "Studio denim" }, { "value": "photo-garden.jpg", "label": "Garden" }, { "value": "product-fan.jpg", "label": "Product fan" }
    ]},
    { "type": "text", "id": "image_alt", "label": "Photo alt text", "default": "Jumper trunks with blue camo waistband at the pool" },
    { "type": "text", "id": "chip", "label": "Chip", "default": "New in" },
    { "type": "select", "id": "chip_color", "label": "Chip colour (one supporting colour)", "default": "yellow", "options": [
      { "value": "yellow", "label": "Yellow" }, { "value": "cyan", "label": "Cyan" }, { "value": "orange", "label": "Orange" }, { "value": "pink", "label": "Pink" }
    ]},
    { "type": "text", "id": "badge_text", "label": "Rotating badge text", "default": "Wear it loud ✦ Play loud ✦ Band first ✦ " }
  ],
  "presets": [{ "name": "Hero · Wear it loud" }]
}
{% endschema %}
