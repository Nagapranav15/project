<section class="hero" aria-label="{{ section.settings.line_1 | append: ' ' | append: section.settings.line_2 | append: ' ' | append: section.settings.line_3 | strip | escape }}">
  <div class="wrap">
    <div>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow"><i></i>{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h1 id="heroTitle">
        {%- for i in (1..3) -%}
          {%- assign key = 'line_' | append: i -%}
          {%- if section.settings[key] != blank -%}<span class="line"><span>{{ section.settings[key] | escape }}</span></span>{%- endif -%}
        {%- endfor -%}
      </h1>
      {%- if section.settings.sub != blank -%}<p class="sub">{{ section.settings.sub | escape }}</p>{%- endif -%}
      <div class="ctas">
        {%- if section.settings.btn_1_label != blank -%}<a class="btn btn-ink" href="{{ section.settings.btn_1_link | default: routes.all_products_collection_url }}">{{ section.settings.btn_1_label | escape }} <span class="arrow">→</span></a>{%- endif -%}
        {%- if section.settings.btn_2_label != blank -%}<a class="btn btn-ghost" href="{{ section.settings.btn_2_link | default: routes.all_products_collection_url }}">{{ section.settings.btn_2_label | escape }}</a>{%- endif -%}
      </div>
      {%- if section.settings.fact_1 != blank or section.settings.fact_2 != blank -%}
        <div class="hero-facts">{% if section.settings.fact_1 != blank %}<span>{{ section.settings.fact_1 | escape }}</span>{% endif %}{% if section.settings.fact_2 != blank %}<span>{{ section.settings.fact_2 | escape }}</span>{% endif %}</div>
      {%- endif -%}
    </div>
    <div class="hero-visual" id="heroVisual">
      <div class="hero-photo" id="heroPhoto">
        {%- if section.settings.image != blank -%}
          {%- assign alt = section.settings.image.alt | default: section.settings.image_alt -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: id: 'heroImg', alt: alt, widths: '500, 800, 1100, 1400', sizes: '(max-width: 860px) 100vw, 500px', fetchpriority: 'high', loading: 'eager' }}
        {%- else -%}
          <img src="{{ 'jumper-hero.jpg' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" id="heroImg" width="1000" height="1250" fetchpriority="high">
        {%- endif -%}
      </div>
      {%- if section.settings.label != blank -%}<div class="hero-label">{{ section.settings.label | escape | newline_to_br }}</div>{%- endif -%}
      {% render 'badge', id: 'ringH' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Summer trunks · Drop 01" },
    { "type": "text", "id": "line_1", "label": "Heading line 1", "default": "Underwear" },
    { "type": "text", "id": "line_2", "label": "Heading line 2", "default": "with the" },
    { "type": "text", "id": "line_3", "label": "Heading line 3", "default": "volume up." },
    { "type": "textarea", "id": "sub", "label": "Text", "default": "Soft stretch trunks for the gym, the office and the rooftop. Same trunks, all day." },
    { "type": "text", "id": "btn_1_label", "label": "Button 1 label", "default": "Shop new in" },
    { "type": "url", "id": "btn_1_link", "label": "Button 1 link" },
    { "type": "text", "id": "btn_2_label", "label": "Button 2 label", "info": "Optional second button. Leave empty to show only one." },
    { "type": "url", "id": "btn_2_link", "label": "Button 2 link", "info": "Empty scrolls to the pack builder." },
    { "type": "text", "id": "fact_1", "label": "Fact 1", "default": "Free shipping over Rs. 999" },
    { "type": "text", "id": "fact_2", "label": "Fact 2", "default": "15-day exchanges" },
    { "type": "header", "content": "Picture" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "4:5 works best. Empty shows the Drop 01 photo." },
    { "type": "text", "id": "image_alt", "label": "Image description", "default": "Three friends in Jumper trunks standing in tall grass under a blue sky" },
    { "type": "textarea", "id": "label", "label": "Sticker", "default": "COMFORT\nCONFIDENCE\nALL DAY" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
