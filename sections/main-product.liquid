{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign tab = section.settings.tab
  assign print_name = product.metafields.custom.print | default: product.type
-%}
<section class="pdp scheme-paper" data-pdp>
  <div class="container">
    <div class="pdp__grid">
      <div class="pdp__gallery">
        {%- for media in product.media -%}
          <figure class="pdp__media" data-media-id="{{ media.id }}">
            {%- if forloop.first and product.compare_at_price > product.price -%}<span class="chip chip--pink">{{ 'products.sale' | t }}</span>{%- elsif forloop.first -%}<span class="chip chip--lime">{{ 'products.new_in' | t }}</span>{%- endif -%}
            {%- if media.media_type == 'image' -%}
              {%- if forloop.first -%}{%- assign load = 'eager' -%}{%- else -%}{%- assign load = 'lazy' -%}{%- endif -%}
              {{ media | image_url: width: 1600 | image_tag: loading: load, widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 55vw, 86vw', alt: media.alt | default: product.title }}
            {%- else -%}
              {{ media | media_tag: image_size: '1200x' }}
            {%- endif -%}
          </figure>
        {%- else -%}
          <figure class="pdp__media"><img src="{{ 'product-fan.jpg' | asset_url }}" alt="{{ product.title | escape }}"></figure>
          <figure class="pdp__media"><img src="{{ 'photo-pool.jpg' | asset_url }}" alt="" loading="lazy"></figure>
          <figure class="pdp__media"><img src="{{ 'product-flatlay.jpg' | asset_url }}" alt="" loading="lazy"></figure>
        {%- endfor -%}
      </div>

      <div class="pdp__info">
        <nav class="pdp__crumbs t-label" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span>/</span>
          {%- if collection -%}<a href="{{ collection.url }}">{{ collection.title }}</a><span>/</span>{%- endif -%}
          <span aria-current="page">{{ product.title }}</span>
        </nav>

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'title' -%}
              <h1 class="t-headline pdp__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

            {%- when 'price' -%}
              <div class="pdp__price" {{ block.shopify_attributes }}>
                <span data-pdp-price>{{ current_variant.price | money }}{% if current_variant.compare_at_price > current_variant.price %} <s class="price__compare">{{ current_variant.compare_at_price | money }}</s>{% endif %}</span>
                {%- if current_variant.compare_at_price > current_variant.price -%}<span class="chip chip--pink">{{ 'products.sale' | t }}</span>{%- endif -%}
              </div>
              {%- if cart.taxes_included -%}
                <p class="t-label" style="color: var(--mute)">{{ 'products.tax_included' | t }}</p>
              {%- endif -%}

            {%- when 'print_tab' -%}
              {%- if print_name != blank -%}
                <div class="pdp__tab" style="background: var(--{{ tab }})" {{ block.shopify_attributes }}>
                  <span class="t-label">{{ 'products.print' | t }}: {{ print_name }}</span>
                  {% render 'sparkle' %}
                </div>
              {%- endif -%}

            {%- when 'buy' -%}
              <div class="pdp__buybox" {{ block.shopify_attributes }}>
                {%- form 'product', product, class: 'pdp__form', data-product-form: '', novalidate: 'novalidate' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}">
                  {%- unless product.has_only_default_variant -%}
                    {%- for option in product.options_with_values -%}
                      <fieldset class="pdp__opt" data-option-index="{{ forloop.index0 }}" style="margin-bottom: 24px">
                        <legend class="t-label"><span>{{ option.name }}: <span data-option-label>{{ option.selected_value }}</span></span>
                          {%- if option.name contains 'ize' and section.settings.size_page != blank -%}<a href="{{ section.settings.size_page.url }}" style="text-decoration: underline">{{ 'products.size_guide' | t }}</a>{%- endif -%}
                        </legend>
                        <div class="swatches">
                          {%- for value in option.values -%}
                            <label class="swatch">
                              <input type="radio" name="{{ option.name | handle }}-{{ section.id }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>
                              <span>{{ value }}</span>
                            </label>
                          {%- endfor -%}
                        </div>
                      </fieldset>
                    {%- endfor -%}
                  {%- endunless -%}

                  <div class="pdp__buy">
                    <div class="qty">
                      <button type="button" class="qty__btn" data-qty-step="-1" aria-label="{{ 'cart.decrease' | t }}">{% render 'icon', icon: 'minus' %}</button>
                      <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'cart.quantity' | t }}" inputmode="numeric">
                      <button type="button" class="qty__btn" data-qty-step="1" aria-label="{{ 'cart.increase' | t }}">{% render 'icon', icon: 'plus' %}</button>
                    </div>
                    <button class="btn" type="submit" data-add-btn{% unless current_variant.available %} disabled{% endunless %}>
                      <span data-add-label>{%- if current_variant.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}</span>
                      {% render 'icon', icon: 'arrow' %}
                    </button>
                  </div>
                  {%- if block.settings.show_dynamic_checkout -%}
                    <div class="pdp__dynamic" style="margin-top: 12px">{{ form | payment_button }}</div>
                  {%- endif -%}
                {%- endform -%}
              </div>

            {%- when 'perks' -%}
              <ul class="pdp__perks" role="list" {{ block.shopify_attributes }}>
                <li>{% render 'sparkle' %}{{ block.settings.perk_1 }}</li>
                <li>{% render 'sparkle' %}{{ block.settings.perk_2 }}</li>
                <li>{% render 'sparkle' %}{{ block.settings.perk_3 }}</li>
              </ul>

            {%- when 'description' -%}
              <div class="accordion" {{ block.shopify_attributes }}>
                <details open>
                  <summary>{{ 'products.details' | t }}</summary>
                  <div class="accordion__body rte">{{ product.description | default: block.settings.fallback }}</div>
                </details>
              </div>

            {%- when 'collapsible' -%}
              <div class="accordion" style="border-top: 0" {{ block.shopify_attributes }}>
                <details>
                  <summary>{{ block.settings.heading }}</summary>
                  <div class="accordion__body rte">{{ block.settings.content }}{{ block.settings.page.content }}</div>
                </details>
              </div>

            {%- when 'spec' -%}
              <table class="spec" {{ block.shopify_attributes }}>
                <tbody>
                  <tr><td class="t-label" style="width: 96px">{{ 'products.fit' | t }}</td><td>{{ block.settings.fit }}</td></tr>
                  <tr><td class="t-label">{{ 'products.body' | t }}</td><td>{{ block.settings.body }}</td></tr>
                  <tr><td class="t-label">{{ 'products.band' | t }}</td><td>{{ block.settings.band }}</td></tr>
                  <tr><td class="t-label">{{ 'products.care' | t }}</td><td>{{ block.settings.care }}</td></tr>
                </tbody>
              </table>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="pdp__sticky" data-pdp-sticky aria-hidden="true">
    <span class="pdp__sticky-title">{{ product.title }}</span>
    <button class="btn btn--lime-on-ink" type="button" data-sticky-add tabindex="-1">{{ 'products.add_to_cart' | t }}</button>
  </div>

  <script type="application/json" data-product-json>{{ product | json }}</script>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ request.origin | append: product.url | json }},
  {%- if product.featured_image -%}"image": [{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],{%- endif -%}
  "description": {{ product.description | strip_html | json }},
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  "offers": [
    {%- for variant in product.variants -%}
      {
        "@type": "Offer",
        {%- if variant.sku != blank -%}"sku": {{ variant.sku | json }},{%- endif -%}
        "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "price": {{ variant.price | divided_by: 100.00 | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "url": {{ request.origin | append: variant.url | json }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>

{% schema %}
{
  "name": "Product",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "tab", "label": "Print tab colour", "default": "cyan", "options": [
      { "value": "yellow", "label": "Yellow" }, { "value": "cyan", "label": "Cyan" }, { "value": "orange", "label": "Orange" }, { "value": "pink", "label": "Pink" }, { "value": "lime", "label": "Lime" }
    ]},
    { "type": "page", "id": "size_page", "label": "Size guide page" }
  ],
  "blocks": [
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "print_tab", "name": "Print tab", "limit": 1 },
    { "type": "buy", "name": "Buy buttons", "limit": 1, "settings": [
      { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout button", "default": true }
    ]},
    { "type": "perks", "name": "Perks", "limit": 1, "settings": [
      { "type": "text", "id": "perk_1", "label": "Perk 1", "default": "Free shipping all India" },
      { "type": "text", "id": "perk_2", "label": "Perk 2", "default": "15-day easy exchange" },
      { "type": "text", "id": "perk_3", "label": "Perk 3", "default": "Soft stretch, all day" }
    ]},
    { "type": "description", "name": "Description", "limit": 1, "settings": [
      { "type": "richtext", "id": "fallback", "label": "Fallback text", "default": "<p>Soft stretch body. Loud woven band. Made to move.</p>" }
    ]},
    { "type": "spec", "name": "Spec table", "limit": 1, "settings": [
      { "type": "text", "id": "fit", "label": "Fit", "default": "Trunk" },
      { "type": "text", "id": "body", "label": "Body", "default": "Soft stretch fabric" },
      { "type": "text", "id": "band", "label": "Band", "default": "Woven, wordmark repeated" },
      { "type": "text", "id": "care", "label": "Care", "default": "Machine wash cool. Wear loud." }
    ]},
    { "type": "collapsible", "name": "Collapsible tab", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping and exchanges" },
      { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Free shipping all India. Dispatch in 24 hours. Exchange unworn packs within 15 days.</p>" },
      { "type": "page", "id": "page", "label": "Content from page" }
    ]}
  ]
}
{% endschema %}
