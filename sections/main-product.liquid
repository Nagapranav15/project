{%- liquid
  assign current = product.selected_or_first_available_variant
  assign hex = product.metafields.custom.swatch.value | default: product.metafields.custom.swatch
  assign colour = product.metafields.custom.colour_label.value | default: product.metafields.custom.colour_label
  assign tag = ''
  if product.compare_at_price > product.price
    assign tag = 'products.sale' | t
  elsif settings.card_new_tag != blank and product.tags contains settings.card_new_tag
    assign tag = settings.card_new_tag
  endif
  assign media_count = product.media.size
  assign form_id = 'product-form-' | append: section.id
  assign size_rows = section.blocks | where: 'type', 'size'
  assign home = routes.root_url
  if home == '/'
    assign home = ''
  endif
-%}
<section class="pdp" data-product data-url="{{ product.url }}" data-title="{{ product.title | escape }}" data-hex="{{ hex | default: '#111111' }}"{% if product.has_only_default_variant %} data-single{% endif %} style="--spark:{{ section.settings.spark }}">
  <div class="wrap pgrid">
    <div class="gallery">
      <div class="stage-wrap">
      <div class="stage">
        {%- if tag != blank -%}<span class="tag">{{ tag | escape }}</span>{%- endif -%}
        {%- for media in product.media -%}
          {%- assign is_on = false -%}
          {%- if current.featured_media and current.featured_media.id == media.id -%}{%- assign is_on = true -%}{%- elsif current.featured_media == blank and forloop.first -%}{%- assign is_on = true -%}{%- endif -%}
          <div class="slide{% if is_on %} on{% endif %}" data-media-id="{{ media.id }}">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                {%- assign alt = media.alt | default: product.title -%}
                {%- if forloop.first -%}{%- assign ld = 'eager' -%}{%- else -%}{%- assign ld = 'lazy' -%}{%- endif -%}
                {{ media | image_url: width: 1500 | image_tag: alt: alt, loading: ld, widths: '500, 750, 1000, 1250, 1500', sizes: '(max-width: 1000px) 100vw, 55vw' }}
              {%- when 'video' -%}
                {{ media | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false }}
              {%- when 'external_video' -%}
                {{ media | external_video_tag }}
              {%- when 'model' -%}
                {{ media | model_viewer_tag }}
              {%- else -%}
                {{ media | media_tag }}
            {%- endcase -%}
          </div>
        {%- else -%}
          <div class="slide on"><div class="ph" style="position:absolute;inset:0;display:grid;place-items:center;background:var(--ink)"><span style="width:30%;fill:var(--lime);display:block">{% render 'mark' %}</span></div></div>
        {%- endfor -%}
        {%- if media_count > 1 -%}
          <div class="gnav"><button type="button" data-prev aria-label="{{ 'accessibility.previous_media' | t }}">←</button><button type="button" data-next aria-label="{{ 'accessibility.next_media' | t }}">→</button></div>
        {%- endif -%}
      </div>
      {%- if section.settings.sticker != blank -%}<div class="hero-label">{{ section.settings.sticker | escape | newline_to_br }}</div>{%- endif -%}
      {%- if section.settings.show_badge -%}{% render 'badge', id: 'ringP' %}{%- endif -%}
      </div>
      {%- if media_count > 1 -%}
        <div class="thumbs">
          {%- for media in product.media -%}
            {%- assign is_on = false -%}
            {%- if current.featured_media and current.featured_media.id == media.id -%}{%- assign is_on = true -%}{%- elsif current.featured_media == blank and forloop.first -%}{%- assign is_on = true -%}{%- endif -%}
            <button type="button" aria-current="{{ is_on }}" aria-label="{{ 'accessibility.media' | t: index: forloop.index }}">{{ media.preview_image | image_url: width: 200 | image_tag: alt: '', loading: 'lazy' }}</button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="pinfo">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span aria-hidden="true">/</span>
        {%- if collection -%}<a href="{{ collection.url }}">{{ collection.title | escape }}</a>{%- else -%}<a href="{{ routes.all_products_collection_url }}">{{ 'collections.eyebrow' | t }}</a>{%- endif -%}
      </nav>
      <h1>{{ product.title | escape }}</h1>
      <div class="pprice" data-price>
        {%- if current.compare_at_price > current.price -%}<s>{{ current.compare_at_price | money_without_trailing_zeros }}</s>{%- endif -%}
        <span>{{ current.price | money_without_trailing_zeros }}</span>
        {%- if current.compare_at_price > current.price -%}
          {%- assign saved = current.compare_at_price | minus: current.price | money_without_trailing_zeros -%}
          <span class="save">{{ 'products.save' | t: amount: saved }}</span>
        {%- endif -%}
        <small>
          {%- if cart.taxes_included -%}{{ 'products.tax_included' | t }}{%- else -%}{{ 'products.tax_excluded' | t }}{%- endif -%}
          {%- if shop.shipping_policy.body != blank %} {{ 'products.shipping_policy_html' | t: link: shop.shipping_policy.url }}{%- endif -%}
        </small>
      </div>
      {%- if colour != blank -%}<span class="colour">{% if hex != blank %}<i style="background:{{ hex }}"></i>{% endif %}{{ colour | escape }}</span>{%- endif -%}

      {%- form 'product', product, id: form_id, class: 'pform', novalidate: 'novalidate', data-product-form: '' -%}
        <input type="hidden" name="id" value="{{ current.id }}">
        <div style="display:grid;gap:22px">
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- assign oname = option.name | downcase -%}
              <fieldset class="popt" data-option>
                <legend class="step-label"><span>{{ option.name | escape }}: <b data-option-value>{{ option.selected_value | escape }}</b></span>
                  {%- if forloop.first and oname contains 'size' -%}
                    {%- if section.settings.size_guide != blank -%}
                      <a href="{{ section.settings.size_guide.url }}">{{ 'products.size_guide' | t }}</a>
                    {%- elsif size_rows.size > 0 -%}
                      <button type="button" class="sg-toggle" aria-haspopup="dialog" aria-expanded="false" aria-controls="sg-{{ section.id }}" data-sg-toggle>{{ 'products.size_guide' | t }}</button>
                    {%- endif -%}
                  {%- endif -%}
                </legend>
                <div class="pills">
                  {%- for value in option.values -%}
                    <label><input type="radio" name="opt-{{ section.id }}-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}><span>{{ value | escape }}</span></label>
                  {%- endfor -%}
                </div>
                {%- if forloop.first and oname contains 'size' and section.settings.size_guide == blank and size_rows.size > 0 -%}
                  {%- comment -%} size guide: drops down under the sizes; the slider or a tapped row picks the size {%- endcomment -%}
                  <dialog class="sg" id="sg-{{ section.id }}" aria-label="{{ 'products.size_guide' | t }}" data-sg data-result="{{ section.settings.sg_result | escape }}" data-between="{{ section.settings.sg_between | escape }}" data-none="{{ section.settings.sg_none | escape }}">
                    <div class="sg-head"><h3>{{ 'products.size_guide' | t }}</h3><button type="button" class="menu-close" data-sg-close>{{ 'accessibility.close' | t }}</button></div>
                    <div class="sg-finder">
                      <label for="sgRange-{{ section.id }}">{{ section.settings.sg_label | escape }} <output data-sg-out>31.5 in</output></label>
                      <input type="range" id="sgRange-{{ section.id }}" min="24" max="46" value="31.5" step="0.5" data-sg-range>
                      <p class="sg-result" data-sg-result aria-live="polite">{{ section.settings.sg_hint | escape }}</p>
                    </div>
                    <table class="sg-table">
                      <thead><tr><th scope="col">{{ 'products.sg_size' | t }}</th><th scope="col">{{ 'products.sg_waist' | t }}</th><th scope="col">{{ 'products.sg_hip' | t }}</th><th scope="col">{{ 'products.sg_jeans' | t }}</th></tr></thead>
                      <tbody>
                        {%- for row in size_rows -%}
                          {%- liquid
                            assign r = row.settings
                            assign wmin = r.waist_min | divided_by: 2.54 | round: 1 | append: '' | replace: '.0', ''
                            assign wmax = r.waist_max | divided_by: 2.54 | round: 1 | append: '' | replace: '.0', ''
                            assign hmin = r.hip_min | divided_by: 2.54 | round: 1 | append: '' | replace: '.0', ''
                            assign hmax = r.hip_max | divided_by: 2.54 | round: 1 | append: '' | replace: '.0', ''
                          -%}
                          <tr data-sg-row data-size="{{ r.label | escape }}" data-wmin="{{ r.waist_min }}" data-wmax="{{ r.waist_max }}" tabindex="0" {{ row.shopify_attributes }}>
                            <th scope="row"><span class="sz-tag">{{ r.label | escape }}</span></th>
                            <td>{{ wmin }}–{{ wmax }}</td><td>{{ hmin }}–{{ hmax }}</td><td>{{ r.jeans | escape }}</td>
                          </tr>
                        {%- endfor -%}
                      </tbody>
                    </table>
                    {%- if section.settings.sg_note != blank -%}<p class="sg-note">{{ section.settings.sg_note | escape }}</p>{%- endif -%}
                  </dialog>
                {%- endif -%}
              </fieldset>
            {%- endfor -%}
          {%- endunless -%}
          <script type="application/json" data-variants>{{ product.variants | json }}</script>
          {%- if product.selling_plan_groups.size > 0 -%}
            <fieldset class="popt">
              <legend class="step-label"><span>{{ product.selling_plan_groups.first.name | escape }}</span></legend>
              <div class="pills">
                {%- unless product.requires_selling_plan -%}<label><input type="radio" name="selling_plan" value="" checked><span>One-time</span></label>{%- endunless -%}
                {%- for group in product.selling_plan_groups -%}{%- for plan in group.selling_plans -%}<label><input type="radio" name="selling_plan" value="{{ plan.id }}"{% if product.requires_selling_plan and forloop.first %} checked{% endif %}><span>{{ plan.name | escape }}</span></label>{%- endfor -%}{%- endfor -%}
              </div>
            </fieldset>
          {%- endif -%}
          <div class="pbuy">
            <div class="pqty"><button type="button" data-qty-step="-1" aria-label="{{ 'products.decrease' | t }}">−</button><label class="sr" for="qty-{{ section.id }}">{{ 'products.quantity' | t }}</label><input id="qty-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric" data-qty-input><button type="button" data-qty-step="1" aria-label="{{ 'products.increase' | t }}">+</button></div>
            <button class="btn btn-ink" type="submit" name="add" data-add{% unless current.available %} disabled{% endunless %}>{% if current.available %}{{ 'products.add_to_cart' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %} <span class="arrow">→</span></button>
            {%- if section.settings.show_dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}
          </div>
          <p class="perr" data-error role="alert" hidden></p>
        </div>
      {%- endform -%}

      {%- if section.settings.fact_1 != blank or section.settings.fact_2 != blank or section.settings.fact_3 != blank -%}
        <div class="pfacts">
          {%- if section.settings.fact_1 != blank -%}<span>{{ section.settings.fact_1 | escape }}</span>{%- endif -%}
          {%- if section.settings.fact_2 != blank -%}<span>{{ section.settings.fact_2 | escape }}</span>{%- endif -%}
          {%- if section.settings.fact_3 != blank -%}<span>{{ section.settings.fact_3 | escape }}</span>{%- endif -%}
        </div>
      {%- endif -%}

      <div class="acc">
        {%- if product.description != blank -%}
          <details{% if section.settings.open_description %} open{% endif %}><summary>{{ section.settings.description_title | escape }}</summary><div class="acc-body rte">{{ product.description }}</div></details>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'tab' -%}
            <details {{ block.shopify_attributes }}><summary>{{ block.settings.title | escape }}</summary><div class="acc-body rte">{{ block.settings.content }}{% if block.settings.page != blank %}{{ block.settings.page.content }}{% endif %}</div></details>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}<div class="papp" {{ block.shopify_attributes }}>{% render block %}</div>{%- endif -%}
      {%- endfor -%}

      {%- if section.settings.pack_title != blank -%}
        {%- assign pack_href = routes.all_products_collection_url -%}
        {%- if section.settings.pack_link != blank -%}{%- assign pack_href = section.settings.pack_link -%}{%- endif -%}
        <a class="packcta" href="{{ pack_href }}"><span><b>{{ section.settings.pack_title | escape }}</b><small>{{ section.settings.pack_text | escape }}</small></span><span class="arrow">→</span></a>
      {%- endif -%}
    </div>
  </div>
  <div class="sticky-buy" data-sticky-buy aria-hidden="true">
    <div class="in"><b>{{ product.title | escape }}</b><span data-sticky-price>{{ current.price | money_without_trailing_zeros }}</span><button class="btn btn-ink" type="button" tabindex="-1">{{ 'products.add_to_cart' | t }}</button></div>
  </div>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_media -%}"image": [{{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}],{%- endif -%}
    "description": {{ product.description | strip_html | json }},
    {%- if current.sku != blank -%}"sku": {{ current.sku | json }},{%- endif -%}
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          {%- if variant.sku != blank -%}"sku": {{ variant.sku | json }},{%- endif -%}
          "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price": {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "url": {{ request.origin | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "select",
      "id": "spark",
      "label": "Spark colour",
      "options": [
        { "value": "var(--pink)", "label": "Pink" },
        { "value": "var(--cyan)", "label": "Cyan" },
        { "value": "var(--orange)", "label": "Orange" },
        { "value": "var(--purple)", "label": "Purple" },
        { "value": "var(--yellow)", "label": "Yellow" }
      ],
      "default": "var(--pink)"
    },
    { "type": "checkbox", "id": "show_badge", "label": "Show spinning badge", "default": false },
    { "type": "textarea", "id": "sticker", "label": "Sticker", "info": "Optional label on the photo. Leave empty for a clean photo." },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show Buy it now button", "default": true },
    { "type": "page", "id": "size_guide", "label": "Size guide page", "info": "Optional. Leave empty to open the size guide under the sizes (add Size blocks)." },
    { "type": "header", "content": "Size guide" },
    { "type": "text", "id": "sg_label", "label": "Slider label", "default": "Your waist" },
    { "type": "text", "id": "sg_hint", "label": "Before sliding", "default": "Slide to your waist, or tap a row below." },
    { "type": "text", "id": "sg_result", "label": "Result", "default": "You're a [[size]]. Picked it for you.", "info": "[[size]] becomes the size." },
    { "type": "text", "id": "sg_between", "label": "Between sizes", "default": "Between [[size]] and [[next]]. Picked [[next]] for room." },
    { "type": "text", "id": "sg_none", "label": "Outside the chart", "default": "Off the chart. Write in and we will help you pick." },
    { "type": "text", "id": "sg_note", "label": "Small print", "default": "Body measurements in inches. Fabric has 4-way stretch." },
    { "type": "text", "id": "fact_1", "label": "Fact 1", "default": "Free shipping over Rs. 999" },
    { "type": "text", "id": "fact_2", "label": "Fact 2", "default": "15-day exchanges" },
    { "type": "text", "id": "fact_3", "label": "Fact 3", "default": "Soft stretch" },
    { "type": "text", "id": "description_title", "label": "Description tab title", "default": "Details" },
    { "type": "checkbox", "id": "open_description", "label": "Open description by default", "default": true },
    { "type": "header", "content": "Pack link" },
    { "type": "text", "id": "pack_title", "label": "Title", "default": "Build a pack" },
    { "type": "text", "id": "pack_text", "label": "Text", "default": "Pick three. Or five. We box them." },
    { "type": "url", "id": "pack_link", "label": "Link", "info": "Empty goes to all trunks. Point it at a page with the pack builder if you add one." }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "size",
      "name": "Size (size guide)",
      "settings": [
        { "type": "text", "id": "label", "label": "Size", "default": "M", "info": "Must match the size option value, for example S, M, L, XL." },
        { "type": "number", "id": "waist_min", "label": "Waist from (cm)", "default": 79, "info": "Enter in cm. The guide shows inches." },
        { "type": "number", "id": "waist_max", "label": "Waist to (cm)", "default": 86 },
        { "type": "number", "id": "hip_min", "label": "Hip from (cm)", "default": 94 },
        { "type": "number", "id": "hip_max", "label": "Hip to (cm)", "default": 101 },
        { "type": "text", "id": "jeans", "label": "Jeans size", "default": "31–32" }
      ]
    },
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Fit" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>True to size. Between sizes? Size up for room, down for hold.</p>" },
        { "type": "page", "id": "page", "label": "Or show a page" }
      ]
    }
  ]
}
{% endschema %}
