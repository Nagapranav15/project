<div class="marquee-container">
  <div class="marquee-track">
    <div class="marquee-item">
      {{ section.settings.text_1 | default: 'ULTRA SOFT' }} <span class="highlight">•</span> 
      {{ section.settings.text_2 | default: 'BREATHABLE' }} <span class="highlight">•</span> 
      {{ section.settings.text_3 | default: 'MICRO MODAL' }} <span class="highlight">•</span> 
      {{ section.settings.text_4 | default: '4-WAY STRETCH' }} <span class="highlight">•</span> 
      {{ section.settings.text_5 | default: 'CONFIDENCE' }} <span class="highlight">•</span> 
      {{ section.settings.text_6 | default: 'ZERO RIDE-UP' }} <span class="highlight">•</span>
    </div>
    <div class="marquee-item">
      {{ section.settings.text_1 | default: 'ULTRA SOFT' }} <span class="highlight">•</span> 
      {{ section.settings.text_2 | default: 'BREATHABLE' }} <span class="highlight">•</span> 
      {{ section.settings.text_3 | default: 'MICRO MODAL' }} <span class="highlight">•</span> 
      {{ section.settings.text_4 | default: '4-WAY STRETCH' }} <span class="highlight">•</span> 
      {{ section.settings.text_5 | default: 'CONFIDENCE' }} <span class="highlight">•</span> 
      {{ section.settings.text_6 | default: 'ZERO RIDE-UP' }} <span class="highlight">•</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Infinite Chrome Marquee",
  "settings": [
    { "type": "text", "id": "text_1", "label": "Word 1", "default": "ULTRA SOFT" },
    { "type": "text", "id": "text_2", "label": "Word 2", "default": "BREATHABLE" },
    { "type": "text", "id": "text_3", "label": "Word 3", "default": "MICRO MODAL" },
    { "type": "text", "id": "text_4", "label": "Word 4", "default": "4-WAY STRETCH" },
    { "type": "text", "id": "text_5", "label": "Word 5", "default": "CONFIDENCE" },
    { "type": "text", "id": "text_6", "label": "Word 6", "default": "ZERO RIDE-UP" }
  ],
  "presets": [
    {
      "name": "Infinite Chrome Marquee"
    }
  ]
}
{% endschema %}
