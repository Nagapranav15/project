{%- comment -%} Core philosophy. Words light up on scroll; personality traits below. {%- endcomment -%}
{%- assign words = section.settings.statement | split: ' ' -%}
<section class="section scheme-{{ section.settings.scheme }} manifesto" id="manifesto">
  <div class="container">
    <p class="t-label section-head__label reveal"><span class="num">{{ section.settings.number }}</span> {{ section.settings.label }}</p>
    <p class="manifesto__statement" data-scrub>
      {%- for w in words -%}
        {%- if w contains '*' -%}
          <span class="scrub scrub--mark">{{ w | remove: '*' }}</span>
        {%- else -%}
          <span class="scrub">{{ w }}</span>
        {%- endif -%}
        {% unless forloop.last %} {% endunless %}
      {%- endfor -%}
    </p>

    <div class="traits">
      {%- for block in section.blocks -%}
        <article class="trait reveal" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <p class="t-label trait__no">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
          <h3 class="trait__title">{{ block.settings.title }}</h3>
          <p class="t-body">{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>

    <div class="voice reveal">
      <div class="voice__col">
        <p class="t-label">{{ 'sections.manifesto.say' | t }}</p>
        <p class="t-subhead">{{ section.settings.say }}</p>
      </div>
      <div class="voice__col voice__col--not">
        <p class="t-label">{{ 'sections.manifesto.not' | t }}</p>
        <p class="t-subhead"><s>{{ section.settings.not }}</s></p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Manifesto",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Ground", "default": "ink", "options": [
      { "value": "ink", "label": "Ink" }, { "value": "paper", "label": "Paper" }
    ]},
    { "type": "text", "id": "number", "label": "Section number", "default": "05" },
    { "type": "text", "id": "label", "label": "Label", "default": "The core philosophy" },
    { "type": "textarea", "id": "statement", "label": "Statement", "info": "Wrap a word in *asterisks* to highlight it.", "default": "*Serious* product. *Bold* attitude. Real quality with a Gen-Z grin. The antithesis of basic, functional inner-wear and of sterile, premium-minimalist labels." },
    { "type": "text", "id": "say", "label": "Say it like this", "default": "Wear it loud." },
    { "type": "text", "id": "not", "label": "Not like this", "default": "Our garments are available in a range of vibrant options." }
  ],
  "blocks": [
    { "type": "trait", "name": "Trait", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Cheeky" },
      { "type": "text", "id": "text", "label": "Text", "default": "A wink, never a smirk." }
    ]}
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Manifesto", "blocks": [{ "type": "trait" }] }]
}
{% endschema %}
