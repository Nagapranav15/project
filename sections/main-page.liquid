{%- assign title = page.title | escape -%}
{% render 'page-hero', eyebrow: section.settings.eyebrow, title: title, badge: section.settings.show_badge %}
{%- if page.content != blank -%}
  <section class="prose">
    <div class="wrap"><div class="prose-card rte">{{ page.content }}</div></div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Jumper" },
    { "type": "checkbox", "id": "show_badge", "label": "Show spinning badge", "default": true }
  ]
}
{% endschema %}
