<section class="lost scheme-lime" style="min-height: 100vh">
  <div class="container" style="display: grid; justify-items: center; gap: 24px">
    {% render 'logo-wordmark', class: 'password__mark', label: shop.name %}
    {% render 'character', name: 'jump', class: 'lost__char' %}
    <h1 class="t-display" style="font-size: clamp(48px, 9vw, 140px)">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p class="t-subhead">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'join__form', style: 'width: min(520px, 100%)' -%}
      <input type="hidden" name="contact[tags]" value="prospect, password page">
      {%- if form.posted_successfully? -%}<p class="form-success">{{ 'newsletter.success' | t }}</p>{%- else -%}
      <div class="join__field"><input type="email" name="contact[email]" required placeholder="{{ 'newsletter.placeholder' | t }}" aria-label="{{ 'newsletter.label' | t }}"><button class="btn btn--lime-on-ink" type="submit">{{ 'newsletter.notify' | t }}</button></div>
      {%- endif -%}
    {%- endform -%}
    <details style="margin-top: 24px">
      <summary class="t-label" style="cursor: pointer; text-decoration: underline">{{ 'password.owner' | t }}</summary>
      {%- form 'storefront_password', class: 'join__form', style: 'margin-top: 16px' -%}
        {%- if form.errors -%}<p class="form-errors">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="join__field"><input type="password" name="password" placeholder="{{ 'password.placeholder' | t }}" aria-label="{{ 'password.placeholder' | t }}"><button class="btn btn--lime-on-ink" type="submit">{{ 'password.enter' | t }}</button></div>
      {%- endform -%}
    </details>
  </div>
</section>
<style>.password__mark { width: min(420px, 80vw); height: auto; }</style>
{% schema %}
{ "name": "Password", "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Loading loud." }] }
{% endschema %}
