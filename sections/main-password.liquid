<div class="pw">
  <div class="wrap top">
    <span class="logo">{% render 'wordmark', label: shop.name %}</span>
    <button class="menu-close" type="button" style="background:var(--ink);color:var(--lime)" onclick="document.getElementById('pwDialog').showModal()">{{ 'password.owner' | t }}</button>
  </div>
  <div class="wrap mid">
    <div>
      <span class="eyebrow">{{ 'password.eyebrow' | t }}</span>
      <h1 style="margin-top:18px">
        {{ section.settings.heading | escape }}
      </h1>
      <p>{% if shop.password_message != blank %}{{ shop.password_message | escape }}{% else %}{{ section.settings.text | escape }}{% endif %}</p>
      {%- form 'customer', class: 'form', novalidate: 'novalidate' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,prelaunch">
        {%- if form.posted_successfully? -%}
          <p class="ok" role="status" style="margin-top:28px;max-width:520px">{{ 'newsletter.success' | t }}</p>
        {%- else -%}
          <div class="field">
            <label class="sr" for="pw-email">{{ 'newsletter.email' | t }}</label>
            <input id="pw-email" type="email" name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t }}" autocomplete="email" required>
            <button type="submit">{{ 'newsletter.submit' | t }}</button>
          </div>
          {%- if form.errors -%}<div class="err" style="margin-top:12px;max-width:520px">{{ form.errors | default_errors }}</div>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
    {% render 'badge', id: 'ringPw' %}
  </div>
  <div class="wrap bottom">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span>
    <span>{{ powered_by_link }}</span>
  </div>
  <dialog id="pwDialog" aria-labelledby="pwTitle">
    <div class="panel">
      <h2 id="pwTitle">{{ 'password.dialog_title' | t }}</h2>
      {%- form 'storefront_password', class: 'fx' -%}
        {%- if form.errors -%}<div class="err" role="alert">{{ form.errors | default_errors }}</div><script>document.addEventListener('DOMContentLoaded',function(){document.getElementById('pwDialog').showModal();});</script>{%- endif -%}
        <label>{{ 'password.password' | t }}<input type="password" name="password" autocomplete="current-password" required></label>
        <div class="actions">
          <button class="btn btn-ink" type="submit">{{ 'password.enter' | t }} <span class="arrow">→</span></button>
          <button class="linkbtn" type="button" onclick="this.closest('dialog').close()">{{ 'accessibility.close' | t }}</button>
        </div>
      {%- endform -%}
    </div>
  </dialog>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wear it loud. Soon." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Drop 01 is almost here. Join the crew and you hear first." }
  ]
}
{% endschema %}
