{%- comment -%}
  Campaign banner: a wide studio photo on plain black with the models on the left, a giant line on the right whose
  last word rolls through the product highlights (MADE TO BE BREATHABLE / ITCH-FREE ...). Each highlight has a chip
  and a one-line detail; tap a chip to pick one. The models drift a touch with the cursor for depth.
{%- endcomment -%}
{%- assign words = section.settings.words | split: ',' -%}
{%- assign chip_labels = section.settings.chips | split: ',' -%}
{%- assign details = section.settings.details | newline_to_br | split: '<br />' -%}
{%- assign tints = 'var(--lime)|var(--pink)|var(--cyan)|var(--orange)|var(--yellow)' | split: '|' -%}
<section class="cb" data-campaign data-speed="{{ section.settings.speed }}" style="--tint: var(--lime)">
  <div class="cb-backdrop" aria-hidden="true"></div>
  <div class="cb-models" data-cb-models>
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1400 | image_tag: alt: section.settings.image.alt, loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '100vw' }}
    {%- else -%}
      <img src="{{ 'campaign-dark.webp' | asset_url }}" alt="" width="1183" height="729" loading="lazy">
    {%- endif -%}
  </div>
  <div class="cb-inner wrap">
    <div class="cb-space" aria-hidden="true"></div>
    <div class="cb-copy" data-cb-copy>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow"><i></i>{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2 class="cb-title">
        <span class="cb-lead">{{ section.settings.lead | escape }}</span>
        <span class="cb-slot" aria-live="polite">
          {%- for w in words -%}
            {%- assign t = forloop.index0 | modulo: 5 -%}
            <span class="cb-word{% if forloop.first %} is-on{% endif %}" data-cb-word="{{ forloop.index0 }}" style="--k: {{ tints[t] }}">{{ w | strip | escape }}</span>
          {%- endfor -%}
        </span>
      </h2>
      <div class="cb-chips" role="group" aria-label="{{ section.settings.chips_label | escape }}">
        {%- for w in words -%}
          {%- assign t = forloop.index0 | modulo: 5 -%}
          {%- assign label = chip_labels[forloop.index0] | strip | default: w -%}
          {%- assign detail = details[forloop.index0] | strip -%}
          <button type="button" data-cb-pick="{{ forloop.index0 }}" data-detail="{{ detail | escape }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" style="--k: {{ tints[t] }}">{{ label | strip | escape }}</button>
        {%- endfor -%}
      </div>
      {%- assign first_detail = details.first | strip -%}
      <p class="cb-detail" data-cb-detail{% if first_detail == blank %} hidden{% endif %}>{{ first_detail | escape }}</p>
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn-lime" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span class="arrow">→</span></a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Campaign banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "A wide dark shot with the models on the left and empty space on the right. Empty uses the Jumper dark studio shot." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What you get" },
    { "type": "text", "id": "lead", "label": "Headline start", "default": "Made to be" },
    { "type": "text", "id": "words", "label": "Rolling highlights", "default": "breathable., itch-free., cotton soft., stretchy.", "info": "Separated by commas. Each finishes the headline." },
    { "type": "text", "id": "chips", "label": "Highlight chips", "default": "Breathable, Itch-free, 95% cotton, 4-way stretch", "info": "Separated by commas, same order as the highlights. Empty uses the highlight words." },
    { "type": "textarea", "id": "details", "label": "Highlight details", "default": "Combed cotton at 180 gsm lets air through, so you stay cool all day.\nThe woven waistband is brushed soft on the inside. Nothing scratches.\n95% combed cotton, right where it touches your skin.\n5% elastane moves every way you do and snaps back into shape.", "info": "One line per highlight, same order." },
    { "type": "range", "id": "speed", "label": "Seconds per word", "min": 1.5, "max": 6, "step": 0.5, "default": 2.5 },
    { "type": "text", "id": "chips_label", "label": "Chips label (screen readers)", "default": "Product highlights" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the trunks" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Campaign banner" }]
}
{% endschema %}
