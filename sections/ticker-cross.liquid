{%- liquid
  assign a = section.settings.text_a | split: ','
  assign b = section.settings.text_b | split: ','
-%}
<section class="cross" aria-label="{{ section.settings.text_a | escape }}">
  <div class="cross__band cross__band--a">
    <div class="ticker ticker--xl" style="--speed: {{ section.settings.speed }}s">
      {%- for pass in (1..2) -%}
        <div class="ticker__track"{% if pass == 2 %} aria-hidden="true"{% endif %}>
          {%- for i in (1..3) -%}{%- for t in a -%}<span class="ticker__item">{{ t | strip }}</span><span class="ticker__dash">–</span>{%- endfor -%}{%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
  {%- if section.settings.text_b != blank -%}
    <div class="cross__band cross__band--b" aria-hidden="true">
      <div class="ticker ticker--xl ticker--reverse" style="--speed: {{ section.settings.speed | plus: 8 }}s">
        {%- for pass in (1..2) -%}
          <div class="ticker__track">
            {%- for i in (1..3) -%}{%- for t in b -%}<span class="ticker__item">{{ t | strip }}</span>{% render 'sparkle', class: 'ticker__spark' %}{%- endfor -%}{%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Crossing tickers",
  "settings": [
    { "type": "text", "id": "text_a", "label": "Ink band phrases (comma separated)", "default": "Wear it loud,Play loud,Band first" },
    { "type": "text", "id": "text_b", "label": "Paper band phrases (comma separated)", "default": "Soft stretch,Loud bands,Made to move,Free shipping all India" },
    { "type": "range", "id": "speed", "label": "Loop duration (seconds)", "min": 10, "max": 80, "step": 2, "default": 30 }
  ],
  "presets": [{ "name": "Crossing tickers" }]
}
{% endschema %}
