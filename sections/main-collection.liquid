{%- liquid
  assign t = collection.title | escape
  assign count_text = 'collections.count' | t: count: collection.products_count
  assign meta = '<span>' | append: count_text | append: '</span>'
  if section.settings.show_meta and section.settings.fact != blank
    assign fact = section.settings.fact | escape
    assign meta = meta | append: '<span>' | append: fact | append: '</span>'
  endif
-%}
{%- capture crumbs -%}<a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span aria-hidden="true">/</span><span>{{ t }}</span>{%- endcapture -%}
{% render 'page-hero', eyebrow: section.settings.eyebrow, title: t, lede: collection.description, meta: meta, badge: section.settings.show_badge, crumbs: crumbs %}

{%- paginate collection.products by section.settings.per_page -%}
  <section class="coll">
    <div class="wrap">
      {% render 'facets', results: collection, url: collection.url, sort_by: collection.sort_by, default_sort: collection.default_sort_by, count: collection.products_count %}
      {%- if collection.products.size > 0 -%}
        <div class="grid">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product, index: forloop.index0 %}
          {%- endfor -%}
        </div>
        {% render 'pager', paginate: paginate %}
      {%- else -%}
        <div class="empty-state">
          {%- if collection.filters.size > 0 and collection.products_count > 0 -%}
            <b>{{ 'collections.no_match' | t }}</b>
            <a class="btn btn-ink" href="{{ collection.url }}?sort_by={{ collection.sort_by }}">{{ 'collections.clear' | t }} <span class="arrow">→</span></a>
          {%- else -%}
            <b>{{ 'collections.empty' | t }}</b>
            <a class="btn btn-ink" href="{{ routes.root_url }}">{{ 'general.404_home' | t }} <span class="arrow">→</span></a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop" },
    { "type": "checkbox", "id": "show_badge", "label": "Show spinning badge", "default": true },
    { "type": "checkbox", "id": "show_meta", "label": "Show fact under the title", "default": true },
    { "type": "text", "id": "fact", "label": "Fact", "default": "Free shipping over Rs. 999" },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16 }
  ]
}
{% endschema %}
