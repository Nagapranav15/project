{%- assign title = 'cart.title' | t -%}
{%- assign count_text = 'cart.item_count' | t: count: cart.item_count -%}
{%- assign meta = '<span>' | append: count_text | append: '</span>' -%}
{% render 'page-hero', eyebrow: section.settings.eyebrow, title: title, meta: meta, badge: true %}
<section class="cartp" data-cart-page>
  <div class="wrap">
    {%- if cart.item_count == 0 -%}
      <div class="empty-state"><b>{{ 'cart.empty_line_1' | t }}<br>{{ 'cart.empty_line_2' | t }}</b><a class="btn btn-ink" href="{{ routes.all_products_collection_url }}">{{ 'cart.shop' | t }} <span class="arrow">→</span></a></div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" id="cartForm" class="cgrid">
        <div class="clines">
          {%- for item in cart.items -%}
            <div class="cline">
              <a href="{{ item.url }}" tabindex="-1">
                {%- if item.image -%}{{ item.image | image_url: width: 300 | image_tag: class: 'thumbimg', alt: '', loading: 'lazy' }}{%- else -%}<span class="thumbimg" style="background:{{ item.properties['_hex'] | default: '#111' }}"></span>{%- endif -%}
              </a>
              <div>
                <h3><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h3>
                <div class="opts">
                  {%- unless item.product.has_only_default_variant -%}{%- for o in item.options_with_values -%}<span>{{ o.name | escape }}: {{ o.value | escape }}</span>{%- endfor -%}{%- endunless -%}
                  {%- for p in item.properties -%}
                    {%- assign first = p.first | slice: 0 -%}
                    {%- if p.last != blank and first != '_' -%}<span>{{ p.first | escape }}: {{ p.last | escape }}</span>{%- endif -%}
                  {%- endfor -%}
                  {%- if item.selling_plan_allocation -%}<span>{{ item.selling_plan_allocation.selling_plan.name | escape }}</span>{%- endif -%}
                  {%- for d in item.line_level_discount_allocations -%}<span>✦ {{ d.discount_application.title | escape }} (−{{ d.amount | money_without_trailing_zeros }})</span>{%- endfor -%}
                </div>
                <div class="ctrl">
                  <div class="pqty">
                    <button type="button" data-cart-step="-1" data-for="qty-{{ forloop.index }}" aria-label="{{ 'products.decrease' | t }}">−</button>
                    <label class="sr" for="qty-{{ forloop.index }}">{{ 'products.quantity' | t }}</label>
                    <input id="qty-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric">
                    <button type="button" data-cart-step="1" data-for="qty-{{ forloop.index }}" aria-label="{{ 'products.increase' | t }}">+</button>
                  </div>
                  <a class="linkbtn" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
                </div>
              </div>
              <div class="pr">
                {%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money_without_trailing_zeros }}</s>{%- endif -%}
                {{ item.final_line_price | money_without_trailing_zeros }}
              </div>
            </div>
          {%- endfor -%}
          <div style="margin-top:20px"><button class="btn btn-ghost" type="submit" name="update">{{ 'cart.update' | t }}</button></div>
        </div>
        <div class="summary">
          <div class="panel" style="padding:0;gap:0">
            {% render 'cart-meter' %}
            <div style="padding:22px;display:grid;gap:14px">
              {%- for d in cart.cart_level_discount_applications -%}
                <div class="row sm"><span>✦ {{ d.title | escape }}</span><span>−{{ d.total_allocated_amount | money_without_trailing_zeros }}</span></div>
              {%- endfor -%}
              <div class="row"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money_without_trailing_zeros }}</span></div>
              <small style="color:var(--muted)">{{ settings.cart_note_text | escape }}</small>
              {%- if settings.cart_show_note -%}
                <details><summary>{{ 'cart.note' | t }}</summary><div class="fx"><textarea name="note" aria-label="{{ 'cart.note' | t }}">{{ cart.note }}</textarea></div></details>
              {%- endif -%}
              <button class="btn btn-ink btn-block" type="submit" name="checkout" style="--spark:var(--lime)">{{ 'cart.checkout' | t }} <span class="arrow">→</span></button>
              {%- if additional_checkout_buttons -%}<div class="additional-checkout-buttons">{{ content_for_additional_checkout_buttons }}</div>{%- endif -%}
            </div>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bag",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Almost yours" }
  ]
}
{% endschema %}
