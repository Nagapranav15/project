{%- liquid
  if search.performed
    assign title = 'search.results_for' | t: terms: search.terms
  else
    assign title = 'search.title' | t
  endif
-%}
<section class="phero ink">
  <div class="wrap">
    <div style="width:100%">
      <span class="eyebrow"><i></i>{{ 'search.eyebrow' | t }}</span>
      <h1><span class="line"><span>{{ title }}</span></span></h1>
      <form class="search-form" action="{{ routes.search_url }}" method="get" role="search" style="margin-top:28px">
        <label class="sr" for="q-{{ section.id }}">{{ 'search.title' | t }}</label>
        <input id="q-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" autocomplete="off">
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit">{{ 'search.submit' | t }} <span class="arrow">→</span></button>
      </form>
      {%- if search.performed -%}<div class="meta"><span>{{ 'search.results_count' | t: count: search.results_count }}</span></div>{%- endif -%}
    </div>
  </div>
</section>

{%- if search.performed -%}
  {%- paginate search.results by section.settings.per_page -%}
    <section class="coll srch">
      <div class="wrap">
        {% render 'facets', results: search, url: routes.search_url, sort_by: search.sort_by, default_sort: search.default_sort_by, count: search.results_count, terms: search.terms %}
        {%- if search.results.size > 0 -%}
          {%- assign products = search.results | where: 'object_type', 'product' -%}
          {%- assign others = search.results | where: 'object_type', 'article' -%}
          {%- assign pages = search.results | where: 'object_type', 'page' -%}
          {%- if products.size > 0 -%}
            <div class="grid">
              {%- for product in products -%}{% render 'product-card', product: product, index: forloop.index0 %}{%- endfor -%}
            </div>
          {%- endif -%}
          {%- assign rest = others | concat: pages -%}
          {%- if rest.size > 0 -%}
            <div class="acards" style="margin-top:56px">
              {%- for item in rest -%}
                <article class="acard" style="--spark:var(--cyan)">
                  <a class="media" href="{{ item.url }}" tabindex="-1">{%- if item.image -%}{{ item.image | image_url: width: 700 | image_tag: alt: '', loading: 'lazy' }}{%- else -%}<span class="ph">{% render 'mark' %}</span>{%- endif -%}</a>
                  <div class="info"><span class="eyebrow">{% if item.object_type == 'article' %}{{ 'search.articles' | t }}{% else %}{{ 'search.pages' | t }}{% endif %}</span><h2><a href="{{ item.url }}">{{ item.title | escape }}</a></h2><p>{{ item.content | strip_html | truncatewords: 22 }}</p></div>
                </article>
              {%- endfor -%}
            </div>
          {%- endif -%}
          {% render 'pager', paginate: paginate %}
        {%- else -%}
          <div class="empty-state"><b>{{ 'search.none' | t: terms: search.terms }}</b><a class="btn btn-ink" href="{{ routes.all_products_collection_url }}">{{ 'cart.shop' | t }} <span class="arrow">→</span></a></div>
        {%- endif -%}
      </div>
    </section>
  {%- endpaginate -%}
{%- else -%}
  <section class="coll">
    <div class="wrap">
      <div class="empty-state"><b>{{ 'search.placeholder' | t }}</b><a class="btn btn-ink" href="{{ routes.all_products_collection_url }}">{{ 'cart.shop' | t }} <span class="arrow">→</span></a></div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Search results",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Results per page", "min": 8, "max": 48, "step": 4, "default": 24 }
  ]
}
{% endschema %}
