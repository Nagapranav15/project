{%- assign tabs = 'cyan,orange,yellow,pink' | split: ',' -%}
<section class="page-hero scheme-lime">
  <div class="container">
    <p class="t-label section-head__label"><span class="num">{{ search.results_count | default: 0 }}</span> {{ 'search.results' | t }}</p>
    <h1 class="t-display page-hero__title">{%- if search.performed -%}“{{ search.terms }}”{%- else -%}{{ 'search.title' | t }}{%- endif -%}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="join__field" style="margin-top: 32px; max-width: 640px; border-color: var(--ink)">
      <input type="hidden" name="type" value="product,page,article">
      <label class="visually-hidden" for="SearchQ">{{ 'search.title' | t }}</label>
      <input id="SearchQ" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" style="color: var(--paper)">
      <button class="btn btn--lime-on-ink" type="submit">{{ 'search.submit' | t }}</button>
    </form>
    {% render 'character', name: 'stroll', class: 'page-hero__char' %}
  </div>
</section>
<section class="section scheme-paper">
  <div class="container">
    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        <div class="grid grid--cards">
          {%- for item in search.results -%}
            {%- assign t = forloop.index0 | modulo: 4 -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item, tab: tabs[t], index: forloop.index0 %}
            {%- else -%}
              <a class="card" href="{{ item.url }}" style="--tab: var(--{{ tabs[t] }})">
                <div class="card__tab"><span class="t-label">{{ item.object_type }}</span></div>
                <div class="card__body"><h3 class="card__title">{{ item.title }}</h3></div>
                <p class="t-body" style="padding: 0 12px 16px">{{ item.content | strip_html | truncatewords: 20 }}</p>
              </a>
            {%- endif -%}
          {%- else -%}
            <div class="empty" style="grid-column: 1 / -1">{% render 'character', name: 'wink' %}<p class="t-subhead">{{ 'search.none' | t: terms: search.terms }}</p></div>
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <div class="grid grid--cards">{% render 'demo-grid', limit: 4, tabs: tabs %}</div>
    {%- endif -%}
  </div>
</section>
{% schema %}{ "name": "Search results" }{% endschema %}
