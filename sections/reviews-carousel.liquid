<section class="reviews-section" id="reviews">
  <div class="container">
    <div class="section-header">
      <span class="badge-neon badge-purple" style="margin-bottom:1rem;">{{ section.settings.sub_title | default: 'COMMUNITY VALIDATION' }}</span>
      <h2 class="section-title text-gradient-chrome">{{ section.settings.title | default: '10,000+ COMFORT REBELS' }}</h2>
      <p class="section-desc">{{ section.settings.desc | default: 'Rated 4.9/5 stars across 15,000+ verified order deliveries.' }}</p>
    </div>

    <div class="reviews-carousel-track">
      {%- for block in section.blocks -%}
        <div class="review-card" {{ block.shopify_attributes }}>
          <div>
            <div class="review-stars">
              ★★★★★
            </div>
            <p class="review-quote">
              "{{ block.settings.quote }}"
            </p>
          </div>
          <div class="review-author">
            {%- if block.settings.avatar != blank -%}
              {{ block.settings.avatar | image_url: width: 120 | image_tag: class: 'review-avatar', loading: 'lazy' }}
            {%- else -%}
              <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&q=80" alt="{{ block.settings.author }}" class="review-avatar">
            {%- endif -%}
            <div class="review-author-info">
              <h4>{{ block.settings.author }}</h4>
              <p>{{ block.settings.location }}</p>
            </div>
          </div>
        </div>
      {%- else -%}
        <div class="review-card">
          <div>
            <div class="review-stars">★★★★★</div>
            <p class="review-quote">"Literally the softest pair I have ever put on. Feels weightless during 12-hour studio sessions. The waistband does not flip or pinch once."</p>
          </div>
          <div class="review-author">
            <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&q=80" alt="KAI S." class="review-avatar">
            <div class="review-author-info">
              <h4>KAI S.</h4>
              <p>Verified Cyber Buyer • Tokyo</p>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews 3D Carousel",
  "settings": [
    { "type": "text", "id": "sub_title", "label": "Sub Title", "default": "COMMUNITY VALIDATION" },
    { "type": "text", "id": "title", "label": "Title", "default": "10,000+ COMFORT REBELS" },
    { "type": "textarea", "id": "desc", "label": "Description", "default": "Rated 4.9/5 stars across 15,000+ verified order deliveries." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Card",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Literally the softest pair I have ever put on. Feels weightless." },
        { "type": "text", "id": "author", "label": "Author Name", "default": "KAI S." },
        { "type": "text", "id": "location", "label": "Author Location / Badge", "default": "Verified Cyber Buyer • Tokyo" },
        { "type": "image_picker", "id": "avatar", "label": "Avatar Image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews 3D Carousel",
      "blocks": [
        { "type": "review", "settings": { "author": "KAI S.", "location": "Verified Cyber Buyer • Tokyo", "quote": "Literally the softest pair I have ever put on. Feels weightless during 12-hour studio sessions." } },
        { "type": "review", "settings": { "author": "MARCUS V.", "location": "Verified Athlete • Los Angeles", "quote": "The 4-way stretch is unmatched. I threw out every ordinary cotton pair I owned." } },
        { "type": "review", "settings": { "author": "ELENA R.", "location": "Fashion Director • Berlin", "quote": "The aesthetics are insane, but the moisture wicking is the real magic. Zero sweat, zero chafing." } }
      ]
    }
  ]
}
{% endschema %}
