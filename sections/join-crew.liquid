{%- comment -%}
  Join the crew: a live member card that takes the visitor's name as they type, then flips on sign-up.
  Uses Shopify's customer form, so sign-ups land in Customers with email marketing consent and the "newsletter" tag.
{%- endcomment -%}
{%- assign anchor = section.settings.anchor | default: section.id | handleize -%}
{%- assign form_id = 'join-' | append: section.id -%}
<section class="join" id="{{ anchor }}" aria-labelledby="title-{{ section.id }}" data-join>
  <div class="wrap">
    <div>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow" style="color:var(--pink)">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2 id="title-{{ section.id }}" style="margin-top:14px">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.lede != blank -%}<p class="lede">{{ section.settings.lede | escape }}</p>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="perks">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}><span class="ic" style="background:{{ block.settings.colour }}">{{ block.settings.icon | escape }}</span><div><b>{{ block.settings.title | escape }}</b><span>{{ block.settings.text | escape }}</span></div></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    <div class="cardwrap">
      {%- form 'customer', id: form_id, class: 'form', novalidate: 'novalidate', data-join-form: '' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,crew">
        <div class="field">
          <label class="sr" for="fname-{{ section.id }}">{{ 'newsletter.first_name' | t }}</label><input id="fname-{{ section.id }}" name="contact[first_name]" type="text" placeholder="{{ 'newsletter.first_name' | t }}" autocomplete="given-name" maxlength="18" data-fname>
          <label class="sr" for="email-{{ section.id }}">{{ 'newsletter.email' | t }}</label><input id="email-{{ section.id }}" name="contact[email]" type="email" placeholder="{{ 'newsletter.placeholder' | t }}" autocomplete="email" required data-email>
          <button type="submit">{{ 'newsletter.submit' | t }}</button>
        </div>
        {%- assign posted = form.posted_successfully? -%}
        <span class="note" data-join-note role="status">
          {%- if form.posted_successfully? -%}
            {{ 'newsletter.success' | t }}
          {%- elsif form.errors -%}
            {{ form.errors | default_errors }}
          {%- else -%}
            {{ section.settings.note | escape }}
          {%- endif -%}
        </span>
      {%- endform -%}
      <div class="crewcard{% if posted %} flip{% endif %}" data-crewcard{% if posted %} data-posted{% endif %}>
        <div class="cc-face cc-front">
          <div class="cc-main">
            <div class="cc-head"><span class="wm">{% render 'wordmark' %}</span><span class="cc-no">Crew Nº <span data-cc-no>0001</span></span></div>
            <div class="cc-body"><span class="cc-label">{{ section.settings.member_label | escape }}</span><div class="cc-name" data-cc-name>{{ section.settings.name_placeholder | escape }}</div></div>
            <div class="cc-foot"><div><span class="cc-label">{{ section.settings.joined_label | escape }}</span><b>{{ 'now' | date: '%b %Y' }}</b></div><div><span class="cc-label">{{ section.settings.perk_label | escape }}</span><b>{{ section.settings.perk | escape }}</b></div><div class="cc-code" aria-hidden="true"></div></div>
          </div>
          <div class="cc-stub" aria-hidden="true">{% render 'mark' %}<span>{{ section.settings.stub | escape }}</span></div>
        </div>
        <div class="cc-face cc-back">
          <span class="eyebrow">{{ section.settings.back_eyebrow | escape }}</span>
          <h3 data-cc-welcome>{{ 'newsletter.welcome' | t }}</h3>
          <p>{{ section.settings.back_text | escape }}</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Join the crew",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "join" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The crew" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the crew." },
    { "type": "textarea", "id": "lede", "label": "Text", "default": "One email and you're in. Here's what the crew gets first." },
    { "type": "header", "content": "Member card" },
    { "type": "text", "id": "member_label", "label": "Name label", "default": "Member" },
    { "type": "text", "id": "name_placeholder", "label": "Name before typing", "default": "Your name" },
    { "type": "text", "id": "joined_label", "label": "Date label", "default": "Joined" },
    { "type": "text", "id": "perk_label", "label": "Perk label", "default": "Perk" },
    { "type": "text", "id": "perk", "label": "Perk", "default": "First dibs" },
    { "type": "text", "id": "stub", "label": "Stub text", "default": "Wear it loud" },
    { "type": "text", "id": "back_eyebrow", "label": "Back eyebrow", "default": "You're in" },
    { "type": "text", "id": "back_text", "label": "Back text", "default": "Watch your inbox. Drop 02 lands there first." },
    { "type": "text", "id": "note", "label": "Note under the form", "default": "Type your name and watch your card. Unsubscribe any time." }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "perk",
      "name": "Perk",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon character", "default": "↯" },
        { "type": "color", "id": "colour", "label": "Icon colour", "default": "#CEFF05" },
        { "type": "text", "id": "title", "label": "Title", "default": "First dibs on every drop" },
        { "type": "text", "id": "text", "label": "Text", "default": "New colours open to the crew a day before anyone else." }
      ]
    }
  ],
  "presets": [
    { "name": "Join the crew", "blocks": [{ "type": "perk" }] }
  ]
}
{% endschema %}
