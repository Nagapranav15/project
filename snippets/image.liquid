{%- comment -%}
  Renders a Shopify image, or falls back to a bundled brand photo from /assets.
  Params: image (Shopify image | blank), fallback (asset filename), alt, class, sizes, loading ('lazy'|'eager'), widths
{%- endcomment -%}
{%- liquid
  assign img_loading = loading | default: 'lazy'
  assign img_sizes = sizes | default: '100vw'
-%}
{%- if image != blank -%}
  {{- image | image_url: width: 1800 | image_tag: loading: img_loading, sizes: img_sizes, widths: '400, 600, 800, 1100, 1400, 1800', class: class, alt: alt | default: image.alt -}}
{%- elsif fallback != blank -%}
  <img src="{{ fallback | asset_url }}" alt="{{ alt | escape }}" class="{{ class }}" loading="{{ img_loading }}" decoding="async">
{%- endif -%}
