{%- comment -%}
  Product card from homepage v4: border, hover lift with a per-card spark, close-up swaps to the on-body shot,
  size buttons and Quick add right on the card.
  Usage: render 'product-card', product: product, index: forloop.index0
         render 'product-card', demo: 'maroon', index: 0   (placeholder when a section has no products yet)
{%- endcomment -%}
{%- liquid
  assign i = index | default: 0 | modulo: 4
  case i
    when 0
      assign spark = 'var(--pink)'
    when 1
      assign spark = 'var(--cyan)'
    when 2
      assign spark = 'var(--orange)'
    else
      assign spark = 'var(--purple)'
  endcase
  assign size_name = settings.card_size_option | default: 'Size' | downcase
-%}
{%- if product != blank -%}
  {%- liquid
    assign size_opt = nil
    for o in product.options_with_values
      assign oname = o.name | downcase
      if oname == size_name or oname == 'size' or oname == 'sizes'
        assign size_opt = o
      endif
    endfor
    assign hex = product.metafields.custom.swatch.value | default: product.metafields.custom.swatch
    assign colour = product.metafields.custom.colour_label.value | default: product.metafields.custom.colour_label
    if colour == blank
      for o in product.options_with_values
        assign oname = o.name | downcase
        if oname == 'color' or oname == 'colour'
          assign colour = o.selected_value | default: o.values.first
        endif
      endfor
    endif
    assign tag = ''
    if product.compare_at_price > product.price
      assign tag = 'products.sale' | t
    elsif settings.card_new_tag != blank and product.tags contains settings.card_new_tag
      assign tag = settings.card_new_tag
    endif
    assign img2 = product.media[1]
    assign first_avail = product.selected_or_first_available_variant
  -%}
  <article class="card" style="--spark:{{ spark }}" data-card data-title="{{ product.title | escape }}" data-hex="{{ hex | default: '#111111' }}">
    <a class="media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
      {%- if tag != blank -%}<span class="tag">{{ tag | escape }}</span>{%- endif -%}
      {%- if product.featured_media -%}
        {%- assign alt = product.featured_media.alt | default: product.title -%}
        {{ product.featured_media | image_url: width: 900 | image_tag: class: 'close', alt: alt, loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(max-width: 560px) 78vw, (max-width: 1000px) 50vw, 25vw' }}
        {%- if img2 -%}
          {{ img2 | image_url: width: 900 | image_tag: class: 'wide', alt: '', loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(max-width: 560px) 78vw, (max-width: 1000px) 50vw, 25vw' }}
        {%- endif -%}
      {%- else -%}
        <span class="ph">{% render 'mark' %}</span>
      {%- endif -%}
    </a>
    <div class="info">
      <div class="row">
        <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
        <span class="price{% if product.compare_at_price > product.price %} sale{% endif %}">
          {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>{%- endif -%}
          {%- if product.price_varies -%}{%- assign pmin = product.price_min | money_without_trailing_zeros -%}{{ 'products.from' | t: price: pmin }}{%- else -%}{{ product.price | money_without_trailing_zeros }}{%- endif -%}
        </span>
      </div>
      {%- if colour != blank -%}
        <span class="colour">{% if hex != blank %}<i style="background:{{ hex }}"></i>{% endif %}{{ colour | escape }}</span>
      {%- endif -%}
      {%- if product.available == false -%}
        <button class="qa soldout" type="button" disabled>{{ 'products.sold_out' | t }}</button>
      {%- elsif size_opt != nil -%}
        {%- assign size_idx = size_opt.position | minus: 1 -%}
        <div class="sizes" role="group" aria-label="{{ 'products.size_for' | t: title: product.title | escape }}">
          {%- for value in size_opt.values -%}
            {%- liquid
              assign vid = ''
              assign vavail = false
              for v in product.variants
                if v.options[size_idx] == value
                  if vid == ''
                    assign vid = v.id
                  endif
                  if v.available
                    assign vid = v.id
                    assign vavail = true
                    break
                  endif
                endif
              endfor
            -%}
            <button type="button" aria-pressed="false" data-variant="{{ vid }}"{% unless vavail %} disabled{% endunless %}>{{ value | escape }}</button>
          {%- endfor -%}
        </div>
        <button class="qa" type="button">{{ 'products.quick_add' | t }}</button>
      {%- elsif product.has_only_default_variant -%}
        <button class="qa" type="button" data-variant="{{ first_avail.id }}">{{ 'products.quick_add' | t }}</button>
      {%- else -%}
        <a class="qa choose" href="{{ product.url }}">{{ 'products.choose_options' | t }}</a>
      {%- endif -%}
    </div>
  </article>
{%- else -%}
  {%- liquid
    case demo
      when 'yellow'
        assign d_name = 'Sunshine Trunk'
        assign d_colour = 'Yellow, ink band'
        assign d_hex = '#d9bf2e'
        assign d_tag = 'New in'
      when 'navy'
        assign d_name = 'Navy Trunk'
        assign d_colour = 'Navy, ink band'
        assign d_hex = '#22285a'
        assign d_tag = ''
      when 'grey'
        assign d_name = 'Heather Trunk'
        assign d_colour = 'Grey, white band'
        assign d_hex = '#b9bab5'
        assign d_tag = ''
      else
        assign d_name = 'Maroon Trunk'
        assign d_colour = 'Maroon, orange band'
        assign d_hex = '#5a2230'
        assign d_tag = 'New in'
    endcase
    assign d_id = demo | default: 'maroon'
    assign close_src = 'trunk-' | append: d_id | append: '-close.jpg'
    assign wide_src = 'trunk-' | append: d_id | append: '-wide.jpg'
  -%}
  <article class="card" style="--spark:{{ spark }}" data-card data-demo data-title="{{ d_name }}" data-hex="{{ d_hex }}" data-img="{{ close_src | asset_url }}">
    <a class="media" href="{{ routes.all_products_collection_url }}" aria-label="{{ d_name }}">
      {%- if d_tag != blank -%}<span class="tag">{{ d_tag }}</span>{%- endif -%}
      <img class="close" src="{{ close_src | asset_url }}" alt="{{ 'products.close_up' | t: title: d_name }}" loading="lazy" width="900" height="1125">
      <img class="wide" src="{{ wide_src | asset_url }}" alt="" loading="lazy" width="900" height="1125">
    </a>
    <div class="info">
      <div class="row"><h3><a href="{{ routes.all_products_collection_url }}">{{ d_name }}</a></h3><span class="price">{{ demo_price | default: 79900 | money_without_trailing_zeros }}</span></div>
      <span class="colour"><i style="background:{{ d_hex }}"></i>{{ d_colour }}</span>
      <div class="sizes" role="group" aria-label="{{ 'products.size_for' | t: title: d_name }}"><button type="button" aria-pressed="false">S</button><button type="button" aria-pressed="false">M</button><button type="button" aria-pressed="false">L</button><button type="button" aria-pressed="false">XL</button></div>
      <button class="qa" type="button">{{ 'products.quick_add' | t }}</button>
    </div>
  </article>
{%- endif -%}
