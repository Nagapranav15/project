<div class="drawer" id="CartDrawer" data-cart-drawer aria-hidden="true">
  <div class="drawer__scrim" data-cart-close></div>
  <aside class="drawer__panel window" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" tabindex="-1">
    <div class="window__bar">
      <span class="window__dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="t-label">bag.exe</span>
      <button class="icon-btn" type="button" data-cart-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button>
    </div>
    <div class="drawer__inner" id="cart-drawer-contents" data-cart-contents>
      {% render 'cart-drawer-contents' %}
    </div>
  </aside>
</div>
