{%- comment -%}
  Onboarding cards shown until real products are assigned. Uses bundled brand photography.
  Params: limit, tabs (array of supporting colour names)
{%- endcomment -%}
{%- liquid
  assign demos = 'Blue Camo Trunk|Rs. 799|product-fan.jpg|photo-pool.jpg|Blue camo;Orange Wave Trunk|Rs. 799|product-flatlay.jpg|band-orange-wave.jpg|Orange wave;Court Repeat Trunk|Rs. 849|photo-court.jpg|band-navy-repeat.jpg|Navy court repeat;Garden Doodle Trunk|Rs. 849|photo-garden.jpg|band-black-orange-piping.jpg|Doodle print;Studio White Trunk|Rs. 749|photo-denim.jpg|band-white-elastic.jpg|White elastic;Sand Black Trunk|Rs. 749|photo-beach.jpg|band-black-woven.jpg|Black woven;Lime Shadow Trunk|Rs. 799|product-flatlay.jpg|band-lime-shadow.jpg|Lime shadow camo;Orange Mesh Trunk|Rs. 849|product-fan.jpg|band-orange-mesh.jpg|Orange woven mesh' | split: ';'
-%}
{%- for demo in demos limit: limit -%}
  {%- assign t = forloop.index0 | modulo: tabs.size -%}
  {% render 'product-card', demo: demo, tab: tabs[t], index: forloop.index0, eager: forloop.first %}
{%- endfor -%}
