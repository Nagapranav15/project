{% comment %}
  Renders a price component
  Accepts:
  - product: {Object} Product Liquid object
  - price_class: {String} CSS class
{% endcomment %}

<div class="price {{ price_class }}">
  <div class="price__container">
    <div class="price__regular">
      <span class="price-item price-item--regular" style="font-family:var(--font-display); font-size:1.8rem; color:var(--white);">
        {{ product.price | money }}
      </span>
      {%- if product.compare_at_price > product.price -%}
        <s class="price-item price-item--sale" style="color:var(--text-subtle); margin-left:0.5rem; text-decoration:line-through;">
          {{ product.compare_at_price | money }}
        </s>
      {%- endif -%}
    </div>
  </div>
</div>
