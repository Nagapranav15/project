{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign p = target.price | default: product.price
  assign cap = target.compare_at_price | default: product.compare_at_price
-%}
<span class="price{% if cap > p %} price--sale{% endif %}" data-price>
  {%- if product.price_varies and variant == blank -%}{{ 'products.from' | t }} {% endif -%}
  {{- p | money -}}
  {%- if cap > p %} <s class="price__compare">{{ cap | money }}</s>{% endif -%}
</span>
